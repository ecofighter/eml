-- String の関数 (docs/spec/stdlib.md)。位置は UTF-8 のバイトの位置である
main : Unit -> <IO> Unit
main () =
  println (show (String.byte_length "a日b"))
  println (show (String.byte_at 1 "a日b"))
  println (String.slice 1 4 "a日b")
  println (show (String.find "b" "a日b"))
  println (show (String.find "x" "a日b"))
  println (show (String.find "" "abc"))
  println (show (String.contains "日" "a日b"))
  println (show (String.starts_with "a" "é"))
  println (show (String.starts_with "ab" "abc"))
  println (show (String.ends_with "日b" "a日b"))
  println (show (String.ends_with "abcd" "bcd"))
  println (show (String.split "," "a,b,,c"))
  println (show (String.split "," ""))
  println (show (String.split "" "abc"))
  println (show (String.split "::" "a::b::"))
  println (show (String.split "aa" "aaaa"))
  println (show (String.split "日" "a日b日"))
  println (show (String.lines "one\r\ntwo\nthree"))
  println (show (String.lines "a\r"))
  println (show (String.lines "\n"))
  println (show (String.lines ""))
  println (String.join ", " ["x", "y", "z"])
  println (show (String.join "-" []))
  println "[\{String.trim "\t  two words \r\n"}]"
  println "[\{String.trim "   "}]"
  println (show (String.to_int "42"))
  println (show (String.to_int "+7"))
  println (show (String.to_int "007"))
  println (show (String.to_int "-0"))
  println (show (String.to_int "-9223372036854775808"))
  println (show (String.to_int "9223372036854775807"))
  println (show (String.to_int "9223372036854775808"))
  println (show (String.to_int "-9223372036854775809"))
  println (show (String.to_int ""))
  println (show (String.to_int "-"))
  println (show (String.to_int " 1"))
  println (show (String.to_int "1_000"))
