main : Unit -> <IO, Panic> Unit
main () =
  println (show (5 &&& 3))
  println (show (5 ||| 3))
  println (show (5 ^^^ 3))
  println (show (complement 0))
  println (show (1 <<< 63))
  println (show (1 <<< 64))
  println (show ((-8) >>> 1))
  println (show ((-1) >>> 100))
  println (show (1 <<< (-1)))
  println (show (8 <<< (-2)))
  println (show (5 >>> (-1)))
  println (show ((-8) <<< (-64)))
  println (show ((-5) <<< (-9223372036854775807 - 1)))
  println (show ((-5) >>> (-9223372036854775807 - 1)))
  println (show (1 ||| 2 &&& 3))
  println (show (1 <<< 2 + 1))
  println (show (6 &&& 3 == 2))
