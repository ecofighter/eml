# 2つの入力が、それぞれ `var x` を使う関数を定義する。片方は配列の変数である。合成のエフェクトは入力ごとに別の
# 名前になるので、片方を定義し直しても、もう片方の `x` と混ざらない
> count_up : Int -> <Panic> Int
. count_up n =
.   var x = 0
.   for 0 n (fn _ -> x := x + 1)
.   x
.
> squares : Int -> <Panic> Array Int
. squares n =
.   var x = MutArray.make n 0
.   for 0 n (fn i -> x[i] := i * i)
.   MutArray.freeze x
.
> (count_up 4, Array.to_list (squares 4))
> count_up : Int -> <Panic> Int
. count_up n =
.   var x = 10
.   for 0 n (fn _ -> x := x + 2)
.   x
.
> (count_up 4, Array.to_list (squares 4))
