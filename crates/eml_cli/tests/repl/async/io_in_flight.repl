# 読みを待ったまま `deadlock` で止まった run は、driver の保留の操作と記録を残さずに回復し、次の入力の run は driver の
# 読みと書きを使える (docs/spec/vm.md の「時計と driver」)
> import Async
> import Net
> import Bytes
> import String
> connected : Unit -> <IO, Panic, Async.Async> (Net.TcpStream, Net.TcpStream)
. connected () =
.   let l = Net.listen "127.0.0.1" 0
.   let (port, l) = Net.local_port l
.   let t = Async.start (fn () ->
.     let (s, l) = Net.accept l
.     Net.close_listener l
.     s)
.   let c = Net.connect "127.0.0.1" port
.   (c, Async.await t)
.
> stuck : Unit -> <IO, Panic, Async.Async> Unit
. stuck () =
.   let (a, b) = connected ()
.   let t = Async.start (fn () ->
.     let (buf, a) = Net.read_chunk (Bytes.empty ()) a
.     Net.close a
.     buf)
.   let _ = Async.await t
.   Net.close b
.
> Async.run stuck
> println "next"
> echo : String -> <IO, Panic, Async.Async> String
. echo s =
.   let (a, b) = connected ()
.   let a = Net.write s a
.   Net.close a
.   let (buf, b) = Net.read_chunk (Bytes.empty ()) b
.   Net.close b
.   String.decode buf
.
> println (Async.run (fn () -> echo "hello"))
