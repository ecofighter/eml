# 値としても使うローカル関数 `g` の ABI は名前で決まる。`d` を展開する深さが入力ごとに違っても、`d$let$g` は同じ
# コードになり、追記の「同じ名前なら同じコード」の確かめを通る (docs/spec/lir.md の「一様な関数」)
> d : Int -> Int
. d x =
.   let g y = y + 1
.   let fs = [g]
.   g x + List.length fs
.
> x1 : Int -> Int
. x1 n = d n
.
> x2 : Int -> Int
. x2 n = x1 n
.
> x3 : Int -> Int
. x3 n = x2 n
.
> x4 : Int -> Int
. x4 n = x3 n
.
> x5 : Int -> Int
. x5 n = x4 n
.
> x6 : Int -> Int
. x6 n = x5 n
.
> x7 : Int -> Int
. x7 n = x6 n
.
> d 5
> x6 5
> x7 5
