# 前の入力の生産者を、後の入力で `Iter.fold` に渡して融合する。`Iter.fold` の `con` の値の形についての複製と、
# `Iter.map` の閉包の複製の名前は、鍵と呼び出し先の書き換えた後のコードだけから決まるので、追記の「同じ名前なら
# 同じコード」の確かめを通る
> import Yield (Yield(..))
> nums : Int -> Unit -> <Yield Int, Panic> Unit
. nums n () =
.   let go i =
.     if i > n then ()
.     else
.       yield i
.       go (i + 1)
.   go 1
.
> Iter.fold (fn a b -> a + b) 0 (Iter.generate (nums 10))
> Iter.fold (fn a b -> a + b) 0 (Iter.map (fn x -> x * 2) (Iter.generate (nums 10)))
