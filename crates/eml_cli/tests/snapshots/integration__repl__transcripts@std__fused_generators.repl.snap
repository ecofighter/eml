> import Yield (Yield(..))
> nums : Int -> Unit -> <Yield Int, Panic> Unit
. nums n () =
.   let go i =
.     if i > n then ()
.     else
.       yield i
.       go (i + 1)
.   go 1
.
> Iter.fold (fn a b -> a + b) 0 (Iter.generate (nums 10))
55
> Iter.fold (fn a b -> a + b) 0 (Iter.map (fn x -> x * 2) (Iter.generate (nums 10)))
110
