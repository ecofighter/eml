> data Box a = | Box a
> hide : Int -> a -> <Panic> Box a
. hide n x = if n <= 0 then Box x else hide (n - 1) x
.
> match hide 0 Some with | Box g -> g 4
Some 4
> con : Int -> Int
. con x = x
.
> op : Int -> Int
. op x = x
.
> cont : Int -> Int
. cont x = x
.
