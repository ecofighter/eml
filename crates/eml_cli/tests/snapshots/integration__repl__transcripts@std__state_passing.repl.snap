> import Std.State (State(..))
> bump : Int -> <State Int, Panic> Unit
. bump i = put (get () + i)
. loop : Int -> Int -> <State Int, Panic> Unit
. loop i n =
.   if i > n then ()
.   else
.     bump i
.     loop (i + 1) n
.
> State.exec 0 (fn () -> loop 1 10)
55
> effect Tick where
.   tick : Unit -> Unit
. count : (Unit -> <Tick | e> a) -> <Panic | e> (a, Int)
. count action =
.   handle action () from 0 with
.     | fn tick () c -> ((), c + 1)
.     | return x c -> (x, c)
.
> State.run 0 (fn () -> let (_, t) = count (fn () -> loop 1 4) in t)
(0, 10)
> step : Int -> <State Int, Tick, Panic> Unit
. step i =
.   tick ()
.   put (get () + i)
. ticking : Int -> Int -> <State Int, Tick, Panic> Unit
. ticking i n =
.   if i > n then ()
.   else
.     step i
.     ticking (i + 1) n
.
> State.run 0 (fn () -> let (_, t) = count (fn () -> ticking 1 4) in t)
(4, 10)
> run_loop : Int -> <Panic> Int
. run_loop n = State.exec 0 (fn () -> loop 1 n)
.
> nested : Int -> <Panic> (Int, Int)
. nested n = State.run 0 (fn () -> let (_, t) = count (fn () -> ticking 1 n) in t)
.
> run_loop 10
55
> nested 4
(4, 10)
> 1 + 1
2
> run_loop 10
55
> nested 4
(4, 10)
