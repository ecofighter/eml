effect Main.Ask { ask/1 }
effect Main.Yield { yield/1 }
fn main() -> unit {
  let t.0: unit = handle Main.Ask((), &outer_body) { ask: &outer_ask } return &done
  return t.0
}
fn outer_body(u.0: unit) -> unit {
  tail handle Main.Ask((), &inner_body) { ask: &inner_ask } return &done
}
fn inner_body(u.0: unit) -> unit {
  let t.1: unit = mask [Main.Ask] call asker(())
  let t.2: unit = mask [Main.Ask] apply &rehandle(())
  let t.3: unit = call resumer(())
  tail mask [Main.Ask] apply &asker(())
}
fn asker(u.0: unit) -> unit {
  let s.1: obj = perform Main.Ask.ask(())
  let t.2: unit = extern Prelude.println(s.1)
  return t.2
}
fn rehandle(u.0: unit) -> unit {
  tail handle Main.Ask((), &asker) { ask: &new_ask } return &done
}
fn resumer(u.0: unit) -> unit {
  tail handle Main.Yield((), &yielder) { yield: &yield_clause } return &done
}
fn yielder(u.0: unit) -> unit {
  let t.1: unit = perform Main.Yield.yield(())
  tail apply &asker(())
}
fn yield_clause(u.0: unit, k.1: obj, s.2: unit) -> unit {
  let t.3: unit = mask [Main.Ask] resume k.1((), s.2)
  tail apply &asker(())
}
fn outer_ask(u.0: unit, k.1: obj, s.2: unit) -> unit {
  let s.3: obj = const "outer"
  tail resume k.1(s.3, s.2)
}
fn inner_ask(u.0: unit, k.1: obj, s.2: unit) -> unit {
  let s.3: obj = const "inner"
  tail resume k.1(s.3, s.2)
}
fn new_ask(u.0: unit, k.1: obj, s.2: unit) -> unit {
  let s.3: obj = const "new"
  tail resume k.1(s.3, s.2)
}
fn done(x.0: unit, s.1: unit) -> unit {
  return x.0
}
