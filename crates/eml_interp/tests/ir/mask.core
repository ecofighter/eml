fn resumer(u0) {
  tailcall handle Main.Yield(&yielder, ()) {yield: &yield_clause} return &done
}
fn yielder(u0) {
  let t1 = perform Main.Yield.yield(())
  tailcall apply &asker(())
}
fn yield_clause(u0, k1^, s2) {
  let t3 = mask[Main.Ask] resume k1((), s2)
  tailcall apply &asker(())
}
fn outer_ask(u0, k1^, s2) {
  let s3^ = const "outer"
  tailcall resume k1(s3, s2)
}
fn inner_ask(u0, k1^, s2) {
  let s3^ = const "inner"
  tailcall resume k1(s3, s2)
}
fn new_ask(u0, k1^, s2) {
  let s3^ = const "new"
  tailcall resume k1(s3, s2)
}
fn done(x0, s1) {
  return x0
}
