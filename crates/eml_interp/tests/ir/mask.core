effect Main.Ask { ask/1 }
effect Main.Yield { yield/1 }
fn main() {
  let t0 = handle Main.Ask(&outer_body, ()) {ask: &outer_ask} return &done
  return t0
}
fn outer_body(u0) {
  tailcall handle Main.Ask(&inner_body, ()) {ask: &inner_ask} return &done
}
fn inner_body(u0) {
  let t1 = mask[Main.Ask] call asker(())
  let t2 = mask[Main.Ask] apply &rehandle(())
  let t3 = call resumer(())
  tailcall mask[Main.Ask] apply &asker(())
}
fn asker(u0) {
  let s1^ = perform Main.Ask.ask(())
  let t2 = extern Prelude.println(s1)
  return t2
}
fn rehandle(u0) {
  tailcall handle Main.Ask(&asker, ()) {ask: &new_ask} return &done
