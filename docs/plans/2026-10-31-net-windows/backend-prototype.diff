+        let mut buf = [0u8; 8];
+        assert_eq!(recv_on(raw(&server), &mut buf, 0), Ok(2));
+        assert_eq!(&buf[..2], b"ab");
+        assert_eq!(recv_on(raw(&server), &mut buf, 0), Err(WSAEWOULDBLOCK));
