+    #[test]
+    fn an_abort_nobody_asked_for_is_other() {
+        let mut b = backend();
+        let (l, s, _client) = served(&mut b);
+        assert!(matches!(b.zero_read(2, &s), Start::Pending(Hold::Buffer)));
+        let over = b.waiters[&2];
+        assert_ne!(unsafe { CancelIoEx(s.raw() as HANDLE, over.cast()) }, 0);
+        match arrival_of(&mut b, 2) {
+            Arrival::Done(Err(e)) => assert_eq!(e.kind(), io::ErrorKind::Other),
+            _ => panic!("not an error"),
+        }
+        b.close(s);
+        b.close(l);
+    }
