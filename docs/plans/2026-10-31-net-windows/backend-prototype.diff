+fn sockaddr(addr: SocketAddr) -> (SOCKADDR_STORAGE, i32) {
+    let mut storage = SOCKADDR_STORAGE::default();
+    let len = match addr {
+        SocketAddr::V4(a) => {
+            let mut sin = SOCKADDR_IN { sin_family: AF_INET, sin_port: a.port().to_be(), ..Default::default() };
+            sin.sin_addr.S_un.S_addr = u32::from_ne_bytes(a.ip().octets());
+            unsafe { (&raw mut storage).cast::<SOCKADDR_IN>().write(sin) };
+            size_of::<SOCKADDR_IN>()
+        }
+        SocketAddr::V6(a) => {
+            let mut sin6 = SOCKADDR_IN6 { sin6_family: AF_INET6, sin6_port: a.port().to_be(), sin6_flowinfo: a.flowinfo(), ..Default::default() };
+            sin6.sin6_addr.u.Byte = a.ip().octets();
+            sin6.Anonymous.sin6_scope_id = a.scope_id();
+            unsafe { (&raw mut storage).cast::<SOCKADDR_IN6>().write(sin6) };
+            size_of::<SOCKADDR_IN6>()
+        }
+    };
+    (storage, len as i32)
+}
+
+fn from_storage(s: &SOCKADDR_STORAGE) -> Option<SocketAddr> {
+    match s.ss_family {
+        AF_INET => {
+            let sin = unsafe { (&raw const *s).cast::<SOCKADDR_IN>().read() };
+            Some(SocketAddr::V4(SocketAddrV4::new(unsafe { sin.sin_addr.S_un.S_addr }.to_ne_bytes().into(), u16::from_be(sin.sin_port))))
+        }
+        AF_INET6 => {
+            let sin6 = unsafe { (&raw const *s).cast::<SOCKADDR_IN6>().read() };
+            Some(SocketAddr::V6(SocketAddrV6::new(unsafe { sin6.sin6_addr.u.Byte }.into(), u16::from_be(sin6.sin6_port), sin6.sin6_flowinfo, unsafe { sin6.Anonymous.sin6_scope_id })))
+        }
+        _ => None,
+    }
+}
+
+fn name_of(s: SOCKET, peer: bool) -> io::Result<SocketAddr> {
+    let mut storage = SOCKADDR_STORAGE::default();
+    let mut len = size_of::<SOCKADDR_STORAGE>() as i32;
+    let p = (&raw mut storage).cast::<SOCKADDR>();
+    check(unsafe { if peer { getpeername(s, p, &mut len) } else { getsockname(s, p, &mut len) } })?;
+    from_storage(&storage).ok_or_else(|| io::Error::other("the peer has no IP address"))
+}
+
