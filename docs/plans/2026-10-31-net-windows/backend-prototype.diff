+    /// ConnectEx を出し、終わりの誤りの番号か成功と、かかった時間を返す
+    fn connect_ex(rig: &mut Rig, peer: SocketAddr, rto: bool) -> (OwnedSocket, Result<(), i32>, Duration) {
+        let s = socket(peer.is_ipv6());
+        let any: SocketAddr = if peer.is_ipv6() { "[::]:0" } else { "0.0.0.0:0" }.parse().unwrap();
+        let (local, len) = sockaddr(any);
+        assert_eq!(unsafe { bind(raw(&s), (&raw const local).cast::<SOCKADDR>(), len) }, 0, "{}", last());
+        if rto {
+            let p = TCP_INITIAL_RTO_PARAMETERS { Rtt: TCP_INITIAL_RTO_DEFAULT_RTT as u16, MaxSynRetransmissions: NO_SYN_RETRANSMISSIONS };
+            let mut bytes = 0;
+            let r = unsafe { WSAIoctl(raw(&s), SIO_TCP_INITIAL_RTO, (&raw const p).cast(), size_of::<TCP_INITIAL_RTO_PARAMETERS>() as u32, ptr::null_mut(), 0, &mut bytes, ptr::null_mut(), None) };
+            assert_eq!(r, 0, "{}", last());
+        }
+        nonblocking(raw(&s));
+        rig.associate(raw(&s));
+        let f: LPFN_CONNECTEX = ext(raw(&s), WSAID_CONNECTEX);
+        let (to, len) = sockaddr(peer);
+        let ov = rig.lend(0);
+        let start = Instant::now();
+        let ok = unsafe { f.unwrap()(raw(&s), (&raw const to).cast(), len, ptr::null(), 0, ptr::null_mut(), ov) };
+        let e = if ok != 0 { WSA_IO_PENDING } else { last() };
+        let r = if e == WSA_IO_PENDING {
+            let p = rig.packet_of(0);
+            result(raw(&s), p.ov).map(drop)
+        } else {
+            rig.unlend(0);
+            Err(e)
+        };
+        (s, r, start.elapsed())
+    }
+
+    /// 待ち受けずに bind だけしたソケットの番地。ここへの接続は拒まれ、ソケットを持つ間はほかに取られない
+    fn refusing(ip: &str) -> (OwnedSocket, SocketAddr) {
+        let addr: SocketAddr = (ip.parse::<std::net::IpAddr>().unwrap(), 0).into();
+        let s = socket(addr.is_ipv6());
+        let (raw_addr, len) = sockaddr(addr);
+        assert_eq!(unsafe { bind(raw(&s), (&raw const raw_addr).cast::<SOCKADDR>(), len) }, 0, "{}", last());
+        let mut storage = SOCKADDR_STORAGE::default();
+        let mut n = size_of::<SOCKADDR_STORAGE>() as i32;
+        assert_eq!(unsafe { getsockname(raw(&s), (&raw mut storage).cast(), &mut n) }, 0);
+        let port = from_storage(&storage).unwrap().port();
+        (s, SocketAddr::new(addr.ip(), port))
+    }
+
+    #[test]
+    fn a_refused_loopback_connect_ex_fails_fast() {
+        for ip in ["127.0.0.1", "::1"] {
+            let mut rig = Rig::new();
+            let (_held, to) = refusing(ip);
+            // 送り直しがあれば約 2 秒かかり、`packet_of` の 1 秒の見張りで落ちる
+            let (_, r, took) = connect_ex(&mut rig, to, true);
+            let code = r.unwrap_err();
+            assert!([WSAECONNREFUSED, ERROR_CONNECTION_REFUSED].contains(&code), "{ip}: {code}");
+            eprintln!("{ip}: refused after {took:?}");
+        }
