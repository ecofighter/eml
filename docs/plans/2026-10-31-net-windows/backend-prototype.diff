+    #[test]
+    fn a_cancel_after_the_packet_is_queued_is_pending() {
+        let mut b = backend();
+        let (mut l, addr) = listening(&mut b);
+        let mut client = TcpStream::connect(addr).unwrap();
+        let Start::Done(r) = b.start(1, Step::Accept { listener: &mut l }) else { panic!() };
+        let mut s = accepted(r);
+        client.write_all(b"ab").unwrap();
+        wait_readable(s.raw());
+        assert!(matches!(b.zero_read(2, &s), Start::Pending(Hold::Buffer)));
+        assert!(matches!(b.cancel(2, Step::Peek { sock: &mut s }), Ok(Cancel::Pending)));
+        // 長さ 0 の受けがその場で終わらず保留になった場合は、取り消しが勝って `Cancelled` になりうる
+        assert!(matches!(arrival_of(&mut b, 2), Arrival::Retry | Arrival::Cancelled));
+        b.close(s);
+        b.close(l);
+    }
