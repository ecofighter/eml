+        let l = raw(&listener);
+        let addr = listener.local_addr().unwrap();
+        listener.set_nonblocking(true).unwrap();
+        rig.associate(l);
+        assert_eq!(accept_on(l).err(), Some(WSAEWOULDBLOCK));
+        let a = socket(false);
+        let mut addrs = Box::new([0u8; 288]);
+        assert_eq!(accept_ex(&mut rig, 0, l, raw(&a), &mut addrs), Ok(WSA_IO_PENDING));
+        rig.only_marks();
+        let c1 = TcpStream::connect(addr).unwrap();
+        let p = rig.packet_of(0);
+        assert_eq!(result(l, p.ov), Ok(0));
+        update_accept(l, raw(&a));
+        nonblocking(raw(&a));
+        rig.associate(raw(&a));
+        assert_eq!(peer_of(raw(&a)), c1.local_addr().unwrap());
+        // 溜まった接続は accept が順に受ける
+        let c2 = TcpStream::connect(addr).unwrap();
+        let c3 = TcpStream::connect(addr).unwrap();
+        for c in [&c2, &c3] {
+            let s = accept_on(l).unwrap();
+            assert_eq!(peer_of(raw(&s)), c.local_addr().unwrap());
+        }
+        assert_eq!(accept_on(l).err(), Some(WSAEWOULDBLOCK));
+        rig.only_marks();
+        // 来ていた接続は AcceptEx が受ける
+        let c4 = TcpStream::connect(addr).unwrap();
+        let b = socket(false);
+        assert!(accept_ex(&mut rig, 1, l, raw(&b), &mut addrs).is_ok());
+        let p = rig.packet_of(1);
+        assert_eq!(result(l, p.ov), Ok(0));
+        update_accept(l, raw(&b));
+        assert_eq!(peer_of(raw(&b)), c4.local_addr().unwrap());
+        rig.only_marks();
+    }
