+    #[test]
+    fn a_connect_ends_connected() {
+        let mut b = backend();
+        let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+        let to = listener.local_addr().unwrap();
+        let mut s = b.socket(to).unwrap();
+        assert!(matches!(b.start(1, Step::Connect { sock: &mut s, peer: to }), Start::Pending(Hold::Buffer)));
+        assert!(matches!(arrival_of(&mut b, 1), Arrival::Done(Ok(Outcome::Connected))));
+        b.shutdown_write(&mut s).unwrap();
+        let (mut server, _) = listener.accept().unwrap();
+        assert_eq!(server.read(&mut [0u8; 4]).unwrap(), 0);
