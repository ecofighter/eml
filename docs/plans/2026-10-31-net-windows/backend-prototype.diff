+    fn served(b: &mut Iocp) -> (Sock, Sock, TcpStream) {
+        let (mut l, addr) = listening(b);
+        let client = TcpStream::connect(addr).unwrap();
+        let Start::Done(r) = b.start(1, Step::Accept { listener: &mut l }) else { panic!("pending") };
+        (l, accepted(r), client)
+    }
