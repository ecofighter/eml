+    #[test]
+    fn os_errors_take_the_kinds_of_the_table() {
+        use io::ErrorKind as K;
+        use windows_sys::Win32::Networking::WinSock::{WSAEADDRINUSE, WSAENOBUFS, WSAESHUTDOWN};
+        assert_eq!(os_error(ERROR_CONNECTION_REFUSED).kind(), K::ConnectionRefused);
+        assert_eq!(os_error(WSAECONNREFUSED).kind(), K::ConnectionRefused);
+        assert_eq!(os_error(WSAEADDRINUSE).kind(), K::AddrInUse);
+        assert_eq!(stream_error(ERROR_NETNAME_DELETED).kind(), K::ConnectionReset);
+        assert_eq!(stream_error(WSAECONNRESET).kind(), K::ConnectionReset);
+        assert_eq!(stream_error(WSAECONNABORTED).kind(), K::ConnectionReset);
+        assert_eq!(stream_error(super::ERROR_CONNECTION_ABORTED).kind(), K::ConnectionReset);
+        assert_eq!(stream_error(WSAESHUTDOWN).kind(), K::BrokenPipe);
+        assert_eq!(accept_error(WSAECONNRESET).kind(), K::ConnectionAborted);
+        assert_eq!(accept_error(ERROR_NETNAME_DELETED).kind(), K::ConnectionAborted);
+        assert_ne!(accept_error(WSAENOBUFS).kind(), K::ConnectionAborted);
+    }
