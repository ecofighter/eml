+    fn send_ex(&mut self, key: OpKey, sock: &Sock, buf: RawBuf) -> Start<Sock> {
+        let wsabuf = WSABUF { len: u32::try_from(buf.cap).unwrap_or(u32::MAX), buf: buf.ptr };
+        let s = sock.raw();
+        self.issue(key, s, What::Send, stream_error, |over| {
+            let ov = unsafe { &raw mut (*over).ov };
+            issued(unsafe { WSASend(s, &wsabuf, 1, ptr::null_mut(), 0, ov, None) } != 0)
+        })
+    }
+
+    fn accept_ex(&mut self, key: OpKey, listener: &Sock) -> Start<Sock> {
+        let sock = match self.stream_socket(listener.v6) {
+            Ok(sock) => sock,
+            Err(e) => return Start::Done(Err(e)),
+        };
+        let s = sock.raw();
+        let l = listener.raw();
+        let accept_ex = self.ext().accept_ex;
+        self.issue(key, l, What::Accept { sock }, accept_error, |over| {
+            let addrs = unsafe { &raw mut (*over).addrs };
+            let ov = unsafe { &raw mut (*over).ov };
+            let mut bytes = 0;
+            issued(unsafe { accept_ex(l, s, addrs.cast(), 0, ADDR_LEN as u32, ADDR_LEN as u32, &mut bytes, ov) } == 0)
+        })
+    }
+}
