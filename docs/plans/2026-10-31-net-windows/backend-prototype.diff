+        assert_eq!(zero_read(raw(&server), ov), Ok(WSA_IO_PENDING));
+        rig.only_marks();
+        client.write_all(b"ab").unwrap();
+        let p = rig.packet_of(0);
+        assert_eq!(p.bytes, 0);
