+    #[test]
+    fn an_overlapped_send_through_the_backend_ends_with_its_size() {
+        let mut b = backend();
+        let (l, s, mut client) = served(&mut b);
+        let mut data = *b"abcd";
+        let buf = RawBuf { ptr: data.as_mut_ptr(), cap: 4 };
+        assert!(matches!(b.send_ex(2, &s, buf), Start::Pending(Hold::Buffer)));
+        assert!(matches!(arrival_of(&mut b, 2), Arrival::Done(Ok(Outcome::Size(4)))));
+        let mut got = [0u8; 4];
+        client.read_exact(&mut got).unwrap();
+        assert_eq!(&got, b"abcd");
+        b.close(s);
+        b.close(l);
+    }
+
+    #[test]
+    fn a_cancelled_pending_write_ends_once() {
+        let mut b = backend();
+        let (l, mut s, _client) = served(&mut b);
+        let mut chunk = vec![7u8; 8 << 20];
+        let buf = RawBuf { ptr: chunk.as_mut_ptr(), cap: chunk.len() };
+        let mut key = 10;
+        while !matches!(b.start(key, Step::Send { sock: &mut s, buf }), Start::Pending(Hold::Buffer)) {
+            key += 1;
+            assert!(key < 18, "8 sends never went pending");
+        }
+        assert!(matches!(b.cancel(key, Step::Send { sock: &mut s, buf }), Ok(Cancel::Pending)));
+        assert!(matches!(arrival_of(&mut b, key), Arrival::Cancelled | Arrival::Done(Ok(Outcome::Size(_)))));
+        b.close(s);
+        b.close(l);
+    }
