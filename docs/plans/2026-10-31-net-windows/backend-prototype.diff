+    fn nonblocking(s: SOCKET) {
+        let mut on = 1u32;
+        assert_eq!(unsafe { ioctlsocket(s, FIONBIO, &mut on) }, 0);
+    }
+
+    fn socket(v6: bool) -> OwnedSocket {
+        let af = if v6 { AF_INET6 } else { AF_INET };
+        let s = unsafe {
+            WSASocketW(i32::from(af), SOCK_STREAM, IPPROTO_TCP, ptr::null(), 0,
+                WSA_FLAG_OVERLAPPED | WSA_FLAG_NO_HANDLE_INHERIT)
+        };
+        assert_ne!(s, INVALID_SOCKET, "{}", last());
+        unsafe { OwnedSocket::from_raw_socket(s as _) }
+    }
+
+    fn sockaddr(addr: SocketAddr) -> (SOCKADDR_STORAGE, i32) {
+        let mut storage = SOCKADDR_STORAGE::default();
+        let len = match addr {
+            SocketAddr::V4(a) => {
+                let mut sin = SOCKADDR_IN { sin_family: AF_INET, sin_port: a.port().to_be(), ..Default::default() };
+                sin.sin_addr.S_un.S_addr = u32::from_ne_bytes(a.ip().octets());
+                unsafe { (&raw mut storage).cast::<SOCKADDR_IN>().write(sin) };
+                size_of::<SOCKADDR_IN>()
+            }
+            SocketAddr::V6(a) => {
+                let mut sin6 = SOCKADDR_IN6 { sin6_family: AF_INET6, sin6_port: a.port().to_be(), sin6_flowinfo: a.flowinfo(), ..Default::default() };
+                sin6.sin6_addr.u.Byte = a.ip().octets();
+                sin6.Anonymous.sin6_scope_id = a.scope_id();
+                unsafe { (&raw mut storage).cast::<SOCKADDR_IN6>().write(sin6) };
+                size_of::<SOCKADDR_IN6>()
+            }
+        };
+        (storage, len as i32)
+    }
+
+    fn peer_of(s: SOCKET) -> SocketAddr {
+        let mut storage = SOCKADDR_STORAGE::default();
+        let mut len = size_of::<SOCKADDR_STORAGE>() as i32;
+        assert_eq!(unsafe { getpeername(s, (&raw mut storage).cast(), &mut len) }, 0, "{}", last());
+        let sin = unsafe { (&raw const storage).cast::<SOCKADDR_IN>().read() };
+        assert_eq!(sin.sin_family, AF_INET);
+        SocketAddr::from((
+            unsafe { sin.sin_addr.S_un.S_addr }.to_ne_bytes(),
+            u16::from_be(sin.sin_port),
+        ))
+    }
+
+    fn recv_on(s: SOCKET, buf: &mut [u8], flags: i32) -> Result<usize, i32> {
+        let n = unsafe { recv(s, buf.as_mut_ptr(), buf.len() as i32, flags) };
+        if n == SOCKET_ERROR { Err(last()) } else { Ok(n as usize) }
+    }
+
+    fn send_on(s: SOCKET, buf: &[u8]) -> Result<usize, i32> {
+        let n = unsafe { send(s, buf.as_ptr(), buf.len() as i32, 0) };
+        if n == SOCKET_ERROR { Err(last()) } else { Ok(n as usize) }
+    }
+
+    fn accept_on(l: SOCKET) -> Result<OwnedSocket, i32> {
+        let s = unsafe { accept(l, ptr::null_mut(), ptr::null_mut()) };
+        if s == INVALID_SOCKET { Err(last()) } else { Ok(unsafe { OwnedSocket::from_raw_socket(s as _) }) }
+    }
+
+    /// 長さ 0 の WSARecv を出す。0 は同期の成功、`Err` はその場の誤り
+    fn zero_read(s: SOCKET, ov: *mut OVERLAPPED) -> Result<i32, i32> {
+        let buf = WSABUF { len: 0, buf: ptr::null_mut() };
+        let mut flags = 0u32;
+        let r = unsafe { WSARecv(s, &buf, 1, ptr::null_mut(), &mut flags, ov, None) };
+        if r == 0 { Ok(0) } else { let e = last(); if e == WSA_IO_PENDING { Ok(e) } else { Err(e) } }
+    }
+
+    fn wsa_send(s: SOCKET, data: &[u8], ov: *mut OVERLAPPED) -> Result<i32, i32> {
+        let buf = WSABUF { len: data.len() as u32, buf: data.as_ptr().cast_mut() };
+        let r = unsafe { WSASend(s, &buf, 1, ptr::null_mut(), 0, ov, None) };
+        if r == 0 { Ok(0) } else { let e = last(); if e == WSA_IO_PENDING { Ok(e) } else { Err(e) } }
+    }
+
+    fn ext<T: Default>(s: SOCKET, guid: GUID) -> T {
+        let mut f = T::default();
+        let mut bytes = 0;
+        let r = unsafe {
+            WSAIoctl(s, SIO_GET_EXTENSION_FUNCTION_POINTER, (&raw const guid).cast(),
+                size_of::<GUID>() as u32, (&raw mut f).cast(), size_of::<T>() as u32,
+                &mut bytes, ptr::null_mut(), None)
+        };
+        assert_eq!(r, 0, "{}", last());
+        f
+    }
+
+    /// ループバックの接続。サーバの端はブロックせず、ポートに結び付ける
+    fn pair(rig: &Rig) -> (TcpStream, TcpStream) {
+        let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+        let client = TcpStream::connect(listener.local_addr().unwrap()).unwrap();
+        let (server, _) = listener.accept().unwrap();
+        server.set_nonblocking(true).unwrap();
+        rig.associate(raw(&server));
+        (client, server)
+    }
+
+    fn wait_readable(s: SOCKET) {
+        let start = Instant::now();
+        let mut b = [0u8; 1];
+        while recv_on(s, &mut b, MSG_PEEK) == Err(WSAEWOULDBLOCK) {
+            assert!(start.elapsed() < LIMIT, "the data did not arrive");
+            thread::yield_now();
+        }
+    }
+
