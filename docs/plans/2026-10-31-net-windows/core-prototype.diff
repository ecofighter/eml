+#[test]
+fn s1_a_full_write_completed_after_a_cancel_succeeds() {
+    let mut data = [1u8; 4];
+    let mut driver = driver();
+    let h = listen(&mut driver);
+    driver.backend.script(1, [Reply::Pending(Hold::Buffer)]);
+    pending(driver.submit(1, Op::Write { handle: h, buf: buf(&mut data) }));
+    driver.backend.cancels.push_back(Ok(Cancel::Pending));
+    driver.cancel(1);
+    driver.backend.events.push(Event { key: 1, arrival: Arrival::Done(Ok(Outcome::Size(4))) });
+    let done = settle(&mut driver);
+    assert_eq!(done[0].result.as_ref().unwrap(), &Done::Size(4));
+    assert!(!done[0].cancelled);
+}
