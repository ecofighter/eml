+// ---- S1 probes ----
+fn held_read(driver: &mut Driver<Fake>, key: OpKey, data: &mut [u8]) -> IoHandle {
+    let h = listen(driver);
+    driver.backend.script(key, [Reply::Pending(Hold::Buffer)]);
+    pending(driver.submit(key, Op::Read { handle: h, buf: buf(data) }));
+    h
+}
+
+fn starts(fake: &Fake) -> usize {
+    fake.calls.iter().filter(|c| matches!(c, Call::Start(..))).count()
+}
+
+#[test]
+fn s1_a_retry_for_a_cancelled_held_op_ends_cancelled() {
+    let mut data = [0u8; 4];
+    let mut driver = driver();
+    held_read(&mut driver, 1, &mut data);
+    driver.backend.cancels.push_back(Ok(Cancel::Pending));
+    driver.cancel(1);
+    driver.backend.events.push(retry(1));
+    let done = settle(&mut driver);
+    assert_eq!(done.len(), 1);
+    assert!(done[0].cancelled);
+    assert_eq!(done[0].result.as_ref().unwrap_err().to_string(), "cancelled");
+    assert_eq!(starts(&driver.backend), 1);
+}
+
+#[test]
+fn s1_a_retry_for_a_held_op_restarts_the_step() {
+    let mut data = [0u8; 4];
+    let mut driver = driver();
+    let h = listen(&mut driver);
+    driver.backend.script(1, [Reply::Pending(Hold::Buffer), Reply::Fill(b"ab".to_vec())]);
+    pending(driver.submit(1, Op::Read { handle: h, buf: buf(&mut data) }));
+    driver.backend.events.push(retry(1));
+    let done = settle(&mut driver);
+    assert_eq!(done[0].result.as_ref().unwrap(), &Done::Size(2));
+    assert_eq!(starts(&driver.backend), 2);
+    assert_eq!(&data[..2], b"ab");
+}
