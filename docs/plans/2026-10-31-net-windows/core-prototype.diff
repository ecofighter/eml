+#[test]
+fn s1_drop_after_a_broken_quiesce_cancels_every_slot_once() {
+    let mut d1 = [0u8; 4];
+    let mut d2 = [0u8; 4];
+    let mut driver = driver();
+    let h1 = listen(&mut driver);
+    let h2 = listen(&mut driver);
+    driver.backend.script(1, [Reply::Pending(Hold::Buffer)]);
+    driver.backend.script(2, [Reply::Pending(Hold::Buffer)]);
+    pending(driver.submit(1, Op::Read { handle: h1, buf: buf(&mut d1) }));
+    pending(driver.submit(2, Op::Read { handle: h2, buf: buf(&mut d2) }));
+    driver.backend.cancels.push_back(Err(io::Error::other("refused")));
+    driver.quiesce();
+    assert_eq!(driver.pending(), 2);
+    assert_eq!(driver.wait(None).unwrap_err().to_string(), "refused");
+    // Drop issues the OS cancel once for every slot that never got one, the refused one included
+    driver.backend.cancels.push_back(Ok(Cancel::Pending));
+    driver.backend.cancels.push_back(Ok(Cancel::Pending));
+    driver.backend.events.push(Event { key: 1, arrival: Arrival::Cancelled });
+    driver.backend.events.push(Event { key: 2, arrival: Arrival::Cancelled });
+    let keys = Arc::clone(&driver.backend.cancelled_keys);
+    let closed = Arc::clone(&driver.backend.closed);
+    drop(driver);
+    let keys = keys.lock().unwrap().clone();
+    // quiesce issued one (refused; which key depends on the table's order), Drop issued one per slot
+    assert_eq!(keys.len(), 3);
+    assert!(keys.contains(&1) && keys.contains(&2));
+    let mut closed = closed.lock().unwrap().clone();
+    closed.sort();
+    assert_eq!(closed, [0, 1]);
+}
