+#[test]
+fn s1_an_event_for_an_unknown_key_closes_only_an_accepted_sock() {
+    let mut driver = driver();
+    let _l = listen(&mut driver);
+    driver.backend.events.push(Event {
+        key: 7,
+        arrival: Arrival::Done(Ok(Outcome::Accepted { sock: FakeSock(9), peer: addr("192.0.2.3:1") })),
+    });
+    assert!(driver.wait(Some(u64::MAX)).unwrap());
+    assert!(completions(&mut driver).is_empty());
+    assert_eq!(driver.pending(), 0);
+    assert!(driver.backend.calls.contains(&Call::Close(9)));
+}
