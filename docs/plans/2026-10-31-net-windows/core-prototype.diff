+#[test]
+fn r1_probe_quiesce_then_drop_second_slot_never_os_cancelled() {
+    let mut d1 = [0u8; 4];
+    let mut d2 = [0u8; 4];
+    let mut driver = driver();
+    let h1 = listen(&mut driver);
+    let h2 = listen(&mut driver);
+    driver.backend.script(1, [Reply::Pending(Hold::Buffer)]);
+    driver.backend.script(2, [Reply::Pending(Hold::Buffer)]);
+    pending(driver.submit(1, Op::Read { handle: h1, buf: buf(&mut d1) }));
+    pending(driver.submit(2, Op::Read { handle: h2, buf: buf(&mut d2) }));
+    driver.backend.cancels.push_back(Err(io::Error::other("refused")));
+    driver.quiesce();
+    let n = driver.backend.calls.iter().filter(|c| matches!(c, Call::Cancel(..))).count();
+    eprintln!("PROBE cancels issued during quiesce: {n}; pending {}", driver.pending());
+    driver.backend.calls.clear();
+    // emulate what Drop would do: see whether it issues any cancel
+    let slots_cancelled_flags = driver.pending();
+    eprintln!("PROBE pending before drop {slots_cancelled_flags}");
+    // push no events: Drop should abort in 1s fake clock; we only check cancels via a panic-free path
+    let calls_ptr = &driver.backend.calls as *const _;
+    let _ = calls_ptr;
+    std::mem::forget(driver);
+}
