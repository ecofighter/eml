+#[test]
+fn s1_drop_does_not_cancel_a_cancelled_held_op_twice() {
+    let mut data = [0u8; 4];
+    let mut driver = driver();
+    held_read(&mut driver, 1, &mut data);
+    driver.backend.cancels.push_back(Ok(Cancel::Pending));
+    driver.cancel(1);
+    driver.backend.events.push(Event { key: 1, arrival: Arrival::Cancelled });
+    let calls = Arc::new(Mutex::new(0usize));
+    // the fake keeps calls inside; count before drop and rely on the single default-Done path
+    let before = driver.backend.calls.iter().filter(|c| matches!(c, Call::Cancel(..))).count();
+    assert_eq!(before, 1);
+    let _ = calls;
+    drop(driver);
+}
