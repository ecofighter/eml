+#[cfg(test)]
+mod tests {
+    use std::cell::UnsafeCell;
+    use std::io::{Read, Write};
+    use std::mem::size_of;
+    use std::net::{Shutdown, SocketAddr, TcpListener, TcpStream};
+    use std::os::windows::io::{AsRawSocket, FromRawSocket, OwnedSocket};
+    use std::sync::Once;
+
+    use windows_sys::Win32::Foundation::{ERROR_NOT_FOUND, HANDLE};
+    use windows_sys::Win32::Networking::WinSock::{
+        AF_INET, AF_INET6, FIONBIO, INVALID_SOCKET, IPPROTO_TCP, LINGER, LPFN_ACCEPTEX,
+        LPFN_CONNECTEX, MSG_PEEK, SD_SEND, SIO_GET_EXTENSION_FUNCTION_POINTER,
+        SIO_TCP_INITIAL_RTO, SO_LINGER, SO_UPDATE_ACCEPT_CONTEXT, SO_UPDATE_CONNECT_CONTEXT,
+        SOCK_STREAM, SOCKADDR, SOCKADDR_IN, SOCKADDR_IN6, SOCKADDR_STORAGE, SOCKET,
+        SOCKET_ERROR, SOL_SOCKET, TCP_INITIAL_RTO_DEFAULT_RTT, TCP_INITIAL_RTO_PARAMETERS,
+        TCP_NODELAY, WSA_FLAG_NO_HANDLE_INHERIT, WSA_FLAG_OVERLAPPED, WSA_IO_PENDING,
+        WSA_OPERATION_ABORTED, WSABUF, WSADATA, WSAECONNABORTED, WSAECONNREFUSED,
+        WSAECONNRESET, WSAEWOULDBLOCK, WSAGetLastError, WSAGetOverlappedResult, WSAID_ACCEPTEX,
+        WSAID_CONNECTEX, WSAIoctl, WSARecv, WSASend, WSASocketW, WSAStartup, accept, bind,
+        getpeername, getsockname, ioctlsocket, recv, send, setsockopt, shutdown,
+    };
+    use windows_sys::Win32::System::IO::{CancelIoEx, CreateIoCompletionPort, OVERLAPPED};
+    use windows_sys::core::GUID;
+
+    use super::*;
+
+    const SOCK: usize = 1;
+    const MARK: usize = 2;
+    const LIMIT: Duration = Duration::from_secs(1);
+    const ERROR_NETNAME_DELETED: i32 = 64;
+    const ERROR_CONNECTION_REFUSED: i32 = 1225;
+    const NO_SYN_RETRANSMISSIONS: u8 = 254;
+
+    fn startup() {
+        static STARTED: Once = Once::new();
+        STARTED.call_once(|| {
+            let mut data = WSADATA::default();
+            assert_eq!(unsafe { WSAStartup(0x202, &mut data) }, 0);
+        });
+    }
+
+    fn last() -> i32 {
+        unsafe { WSAGetLastError() }
+    }
+
+    struct Packet {
+        key: usize,
+        ov: *mut OVERLAPPED,
+        bytes: u32,
+    }
+
+    struct Rig {
+        port: OwnedHandle,
+        ovs: Box<[UnsafeCell<OVERLAPPED>; 8]>,
+        lent: [bool; 8],
+    }
+
+    impl Rig {
+        fn new() -> Rig {
+            startup();
+            let raw = unsafe { CreateIoCompletionPort(INVALID_HANDLE_VALUE, ptr::null_mut(), 0, 1) };
+            let port = OwnedHandle::try_from(unsafe { HandleOrNull::from_raw_handle(raw) }).unwrap();
+            Rig {
+                port,
+                ovs: Box::new(std::array::from_fn(|_| UnsafeCell::new(OVERLAPPED::default()))),
+                lent: [false; 8],
+            }
+        }
+
+        fn associate(&self, s: SOCKET) {
+            let r = unsafe {
+                CreateIoCompletionPort(s as HANDLE, self.port.as_raw_handle(), SOCK, 0)
+            };
+            assert!(!r.is_null(), "{}", io::Error::last_os_error());
+        }
+
+        fn lend(&mut self, i: usize) -> *mut OVERLAPPED {
+            assert!(!self.lent[i]);
+            self.lent[i] = true;
+            let ov = self.ovs[i].get();
+            unsafe { ov.write(OVERLAPPED::default()) };
+            ov
+        }
+
+        /// 同期に失敗して packet の来ない呼び出しの OVERLAPPED を返してもらう
+        fn unlend(&mut self, i: usize) {
+            self.lent[i] = false;
+        }
+
+        fn ov(&self, i: usize) -> *mut OVERLAPPED {
+            self.ovs[i].get()
+        }
+
+        fn next(&mut self, timeout: Duration) -> Option<Packet> {
+            let mut entry = [OVERLAPPED_ENTRY::default(); 1];
+            let mut removed = 0;
+            let ms = super::super::millis(timeout, INFINITE - 1);
+            let ok = unsafe {
+                GetQueuedCompletionStatusEx(
+                    self.port.as_raw_handle(),
+                    entry.as_mut_ptr(),
+                    1,
+                    &mut removed,
+                    ms,
+                    FALSE,
+                )
+            };
+            if ok == 0 {
+                let e = io::Error::last_os_error();
+                assert_eq!(e.raw_os_error(), Some(WAIT_TIMEOUT as i32), "{e}");
+                return None;
+            }
+            let e = entry[0];
+            if let Some(i) = (0..8).find(|&i| self.ovs[i].get() == e.lpOverlapped) {
+                assert!(self.lent[i]);
+                self.lent[i] = false;
+            }
+            Some(Packet {
+                key: e.lpCompletionKey,
+                ov: e.lpOverlapped,
+                bytes: e.dwNumberOfBytesTransferred,
+            })
+        }
+
+        fn packet_of(&mut self, i: usize) -> Packet {
+            let p = self.next(LIMIT).expect("no packet arrived");
+            assert_eq!((p.key, p.ov), (SOCK, self.ov(i)));
+            p
+        }
+
+        fn only_marks(&mut self) {
+            assert_ne!(
+                unsafe { PostQueuedCompletionStatus(self.port.as_raw_handle(), 0, MARK, ptr::null()) },
+                0
+            );
+            let p = self.next(LIMIT).expect("the mark did not arrive");
+            assert_eq!((p.key, p.ov), (MARK, ptr::null_mut()));
+            assert!(self.next(Duration::ZERO).is_none());
+        }
+    }
+
+    impl Drop for Rig {
+        fn drop(&mut self) {
+            if self.lent.iter().any(|&l| l) {
+                eprintln!("a probe left an OVERLAPPED with the kernel; aborting");
+                std::process::abort();
+            }
+        }
+    }
+
+    fn result(s: SOCKET, ov: *mut OVERLAPPED) -> Result<u32, i32> {
+        let mut bytes = 0;
+        let mut flags = 0;
+        let ok = unsafe { WSAGetOverlappedResult(s, ov, &mut bytes, FALSE, &mut flags) };
+        if ok != 0 { Ok(bytes) } else { Err(last()) }
+    }
+
+    fn raw(s: &impl AsRawSocket) -> SOCKET {
+        s.as_raw_socket() as SOCKET
+    }
+
+    fn nonblocking(s: SOCKET) {
+        let mut on = 1u32;
+        assert_eq!(unsafe { ioctlsocket(s, FIONBIO, &mut on) }, 0);
+    }
+
+    fn socket(v6: bool) -> OwnedSocket {
+        let af = if v6 { AF_INET6 } else { AF_INET };
+        let s = unsafe {
+            WSASocketW(i32::from(af), SOCK_STREAM, IPPROTO_TCP, ptr::null(), 0,
+                WSA_FLAG_OVERLAPPED | WSA_FLAG_NO_HANDLE_INHERIT)
+        };
+        assert_ne!(s, INVALID_SOCKET, "{}", last());
+        unsafe { OwnedSocket::from_raw_socket(s as _) }
+    }
+
+    fn sockaddr(addr: SocketAddr) -> (SOCKADDR_STORAGE, i32) {
+        let mut storage = SOCKADDR_STORAGE::default();
+        let len = match addr {
+            SocketAddr::V4(a) => {
+                let mut sin = SOCKADDR_IN { sin_family: AF_INET, sin_port: a.port().to_be(), ..Default::default() };
+                sin.sin_addr.S_un.S_addr = u32::from_ne_bytes(a.ip().octets());
+                unsafe { (&raw mut storage).cast::<SOCKADDR_IN>().write(sin) };
+                size_of::<SOCKADDR_IN>()
+            }
+            SocketAddr::V6(a) => {
+                let mut sin6 = SOCKADDR_IN6 { sin6_family: AF_INET6, sin6_port: a.port().to_be(), sin6_flowinfo: a.flowinfo(), ..Default::default() };
+                sin6.sin6_addr.u.Byte = a.ip().octets();
+                sin6.Anonymous.sin6_scope_id = a.scope_id();
+                unsafe { (&raw mut storage).cast::<SOCKADDR_IN6>().write(sin6) };
+                size_of::<SOCKADDR_IN6>()
+            }
+        };
+        (storage, len as i32)
+    }
+
+    fn peer_of(s: SOCKET) -> SocketAddr {
+        let mut storage = SOCKADDR_STORAGE::default();
+        let mut len = size_of::<SOCKADDR_STORAGE>() as i32;
+        assert_eq!(unsafe { getpeername(s, (&raw mut storage).cast(), &mut len) }, 0, "{}", last());
+        let sin = unsafe { (&raw const storage).cast::<SOCKADDR_IN>().read() };
+        assert_eq!(sin.sin_family, AF_INET);
+        SocketAddr::from((
+            unsafe { sin.sin_addr.S_un.S_addr }.to_ne_bytes(),
+            u16::from_be(sin.sin_port),
+        ))
+    }
+
+    fn recv_on(s: SOCKET, buf: &mut [u8], flags: i32) -> Result<usize, i32> {
+        let n = unsafe { recv(s, buf.as_mut_ptr(), buf.len() as i32, flags) };
+        if n == SOCKET_ERROR { Err(last()) } else { Ok(n as usize) }
+    }
+
+    fn send_on(s: SOCKET, buf: &[u8]) -> Result<usize, i32> {
+        let n = unsafe { send(s, buf.as_ptr(), buf.len() as i32, 0) };
+        if n == SOCKET_ERROR { Err(last()) } else { Ok(n as usize) }
+    }
+
+    fn accept_on(l: SOCKET) -> Result<OwnedSocket, i32> {
+        let s = unsafe { accept(l, ptr::null_mut(), ptr::null_mut()) };
+        if s == INVALID_SOCKET { Err(last()) } else { Ok(unsafe { OwnedSocket::from_raw_socket(s as _) }) }
+    }
+
+    /// 長さ 0 の WSARecv を出す。0 は同期の成功、`Err` はその場の誤り
+    fn zero_read(s: SOCKET, ov: *mut OVERLAPPED) -> Result<i32, i32> {
+        let buf = WSABUF { len: 0, buf: ptr::null_mut() };
+        let mut flags = 0u32;
+        let r = unsafe { WSARecv(s, &buf, 1, ptr::null_mut(), &mut flags, ov, None) };
+        if r == 0 { Ok(0) } else { let e = last(); if e == WSA_IO_PENDING { Ok(e) } else { Err(e) } }
+    }
+
+    fn wsa_send(s: SOCKET, data: &[u8], ov: *mut OVERLAPPED) -> Result<i32, i32> {
+        let buf = WSABUF { len: data.len() as u32, buf: data.as_ptr().cast_mut() };
+        let r = unsafe { WSASend(s, &buf, 1, ptr::null_mut(), 0, ov, None) };
+        if r == 0 { Ok(0) } else { let e = last(); if e == WSA_IO_PENDING { Ok(e) } else { Err(e) } }
+    }
+
+    fn ext<T: Default>(s: SOCKET, guid: GUID) -> T {
+        let mut f = T::default();
+        let mut bytes = 0;
+        let r = unsafe {
+            WSAIoctl(s, SIO_GET_EXTENSION_FUNCTION_POINTER, (&raw const guid).cast(),
+                size_of::<GUID>() as u32, (&raw mut f).cast(), size_of::<T>() as u32,
+                &mut bytes, ptr::null_mut(), None)
+        };
+        assert_eq!(r, 0, "{}", last());
+        f
+    }
+
+    /// ループバックの接続。サーバの端はブロックせず、ポートに結び付ける
+    fn pair(rig: &Rig) -> (TcpStream, TcpStream) {
+        let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+        let client = TcpStream::connect(listener.local_addr().unwrap()).unwrap();
+        let (server, _) = listener.accept().unwrap();
+        server.set_nonblocking(true).unwrap();
+        rig.associate(raw(&server));
+        (client, server)
+    }
+
+    fn wait_readable(s: SOCKET) {
+        let start = Instant::now();
+        let mut b = [0u8; 1];
+        while recv_on(s, &mut b, MSG_PEEK) == Err(WSAEWOULDBLOCK) {
+            assert!(start.elapsed() < LIMIT, "the data did not arrive");
+            thread::yield_now();
+        }
+    }
+
+    #[test]
+    fn a_zero_read_waits_for_data_and_leaves_it() {
+        let mut rig = Rig::new();
+        let (mut client, server) = pair(&rig);
+        let ov = rig.lend(0);
+        assert_eq!(zero_read(raw(&server), ov), Ok(WSA_IO_PENDING));
+        rig.only_marks();
+        client.write_all(b"ab").unwrap();
+        let p = rig.packet_of(0);
+        assert_eq!(p.bytes, 0);
+        assert_eq!(result(raw(&server), p.ov), Ok(0));
+        let mut buf = [0u8; 8];
+        assert_eq!(recv_on(raw(&server), &mut buf, 0), Ok(2));
+        assert_eq!(&buf[..2], b"ab");
+        assert_eq!(recv_on(raw(&server), &mut buf, 0), Err(WSAEWOULDBLOCK));
+    }
+
+    #[test]
+    fn a_zero_read_completes_on_a_closed_peer() {
+        let mut rig = Rig::new();
+        let (client, server) = pair(&rig);
+        let ov = rig.lend(0);
+        assert_eq!(zero_read(raw(&server), ov), Ok(WSA_IO_PENDING));
+        client.shutdown(Shutdown::Write).unwrap();
+        let p = rig.packet_of(0);
+        assert_eq!(result(raw(&server), p.ov), Ok(0));
+        assert_eq!(recv_on(raw(&server), &mut [0u8; 8], 0), Ok(0));
+    }
+
+    #[test]
+    fn a_zero_read_ends_on_a_reset() {
+        let mut rig = Rig::new();
+        let (client, server) = pair(&rig);
+        let ov = rig.lend(0);
+        assert_eq!(zero_read(raw(&server), ov), Ok(WSA_IO_PENDING));
+        let linger = LINGER { l_onoff: 1, l_linger: 0 };
+        assert_eq!(unsafe { setsockopt(raw(&client), SOL_SOCKET, SO_LINGER, (&raw const linger).cast(), size_of::<LINGER>() as i32) }, 0);
+        drop(client);
+        let p = rig.packet_of(0);
+        let code = match result(raw(&server), p.ov) {
+            Err(code) => code,
+            Ok(_) => recv_on(raw(&server), &mut [0u8; 8], 0).unwrap_err(),
+        };
+        assert!([WSAECONNRESET, WSAECONNABORTED, ERROR_NETNAME_DELETED].contains(&code), "{code}");
+    }
+
+    #[test]
+    fn a_zero_read_on_buffered_data_queues_a_packet_that_a_cancel_does_not_find() {
+        let mut rig = Rig::new();
+        let (mut client, server) = pair(&rig);
+        client.write_all(b"ab").unwrap();
+        wait_readable(raw(&server));
+        let ov = rig.lend(0);
+        assert_eq!(zero_read(raw(&server), ov), Ok(0));
+        assert_eq!(unsafe { CancelIoEx(raw(&server) as HANDLE, ov) }, 0);
+        assert_eq!(io::Error::last_os_error().raw_os_error(), Some(ERROR_NOT_FOUND as i32));
+        let p = rig.packet_of(0);
+        assert_eq!(result(raw(&server), p.ov), Ok(0));
+        rig.only_marks();
+        assert_eq!(recv_on(raw(&server), &mut [0u8; 8], 0), Ok(2));
+    }
+
+    #[test]
+    fn a_cancelled_zero_read_ends_aborted() {
+        let mut rig = Rig::new();
+        let (_client, server) = pair(&rig);
+        let ov = rig.lend(0);
+        assert_eq!(zero_read(raw(&server), ov), Ok(WSA_IO_PENDING));
+        assert_ne!(unsafe { CancelIoEx(raw(&server) as HANDLE, ov) }, 0);
+        let p = rig.packet_of(0);
+        assert_eq!(result(raw(&server), p.ov), Err(WSA_OPERATION_ABORTED));
+    }
+
+    #[test]
+    fn calls_without_an_overlapped_queue_no_packet() {
+        let mut rig = Rig::new();
+        let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+        listener.set_nonblocking(true).unwrap();
+        rig.associate(raw(&listener));
+        assert_eq!(accept_on(raw(&listener)).err(), Some(WSAEWOULDBLOCK));
+        let mut client = TcpStream::connect(listener.local_addr().unwrap()).unwrap();
+        let start = Instant::now();
+        let server = loop {
+            match accept_on(raw(&listener)) {
+                Ok(s) => break s,
+                Err(WSAEWOULDBLOCK) if start.elapsed() < LIMIT => thread::yield_now(),
+                Err(e) => panic!("{e}"),
+            }
+        };
+        let s = raw(&server);
+        nonblocking(s);
+        // 受けたソケットはポートに結び付いていない
+        rig.associate(s);
+        let mut buf = [0u8; 8];
+        assert_eq!(recv_on(s, &mut buf, 0), Err(WSAEWOULDBLOCK));
+        client.write_all(b"ab").unwrap();
+        wait_readable(s);
+        assert_eq!(recv_on(s, &mut buf, 0), Ok(2));
+        assert_eq!(send_on(s, b"cd"), Ok(2));
+        let on = 1u32;
+        assert_eq!(unsafe { setsockopt(s, IPPROTO_TCP, TCP_NODELAY, (&raw const on).cast(), 4) }, 0);
+        let mut storage = SOCKADDR_STORAGE::default();
+        let mut len = size_of::<SOCKADDR_STORAGE>() as i32;
+        assert_eq!(unsafe { getsockname(s, (&raw mut storage).cast(), &mut len) }, 0);
+        assert_eq!(peer_of(s), client.local_addr().unwrap());
+        let _: LPFN_CONNECTEX = ext(s, WSAID_CONNECTEX);
+        assert_eq!(unsafe { shutdown(s, SD_SEND) }, 0);
+        rig.only_marks();
+        let mut got = [0u8; 2];
+        client.read_exact(&mut got).unwrap();
+        assert_eq!(&got, b"cd");
+    }
+
+    #[test]
+    fn an_overlapped_send_that_completes_at_once_still_queues_a_packet() {
+        let mut rig = Rig::new();
+        let (mut client, server) = pair(&rig);
+        let ov = rig.lend(0);
+        assert_eq!(wsa_send(raw(&server), b"abcd", ov), Ok(0));
+        let p = rig.packet_of(0);
+        assert_eq!((p.bytes, result(raw(&server), p.ov)), (4, Ok(4)));
+        rig.only_marks();
+        let mut got = [0u8; 4];
+        client.read_exact(&mut got).unwrap();
+        assert_eq!(&got, b"abcd");
+    }
+
+    #[test]
+    fn an_overlapped_send_on_a_full_socket_pends_and_cancels() {
+        let mut rig = Rig::new();
+        let (mut client, server) = pair(&rig);
+        let chunk = vec![7u8; 1 << 16];
+        let mut filled = 0usize;
+        loop {
+            match send_on(raw(&server), &chunk) {
+                Ok(n) => filled += n,
+                Err(WSAEWOULDBLOCK) => break,
+                Err(e) => panic!("{e}"),
+            }
+            assert!(filled < 1 << 28, "the send buffer never filled");
+        }
+        // 送りの buffer は広がりうるので、塞がった後の重なった送りがその場で終わることもある。確かめるのは
+        // WSAEWOULDBLOCK で断られないことである
+        let big = vec![7u8; 8 << 20];
+        let ov = rig.lend(0);
+        assert!(wsa_send(raw(&server), &big, ov).is_ok());
+        // 相手が 1 MiB まで読んでから取り消す (S4 の P-5)
+        let mut drained = 0;
+        let mut sink = vec![0u8; 1 << 16];
+        while drained < 1 << 20 {
+            drained += client.read(&mut sink).unwrap();
+        }
+        let cancelled = unsafe { CancelIoEx(raw(&server) as HANDLE, ov) } != 0;
+        assert!(cancelled || io::Error::last_os_error().raw_os_error() == Some(ERROR_NOT_FOUND as i32));
+        let p = rig.packet_of(0);
+        match result(raw(&server), p.ov) {
+            Ok(n) => {
+                assert!(n as usize <= big.len());
+                eprintln!("the cancelled send ended Ok({n})");
+            }
+            Err(e) => {
+                assert_eq!(e, WSA_OPERATION_ABORTED);
+                eprintln!("the cancelled send ended aborted");
+            }
+        }
+        rig.only_marks();
+    }
+
+    fn accept_ex(rig: &mut Rig, i: usize, l: SOCKET, a: SOCKET, addrs: &mut [u8; 288]) -> Result<i32, i32> {
+        let f: LPFN_ACCEPTEX = ext(l, WSAID_ACCEPTEX);
+        let ov = rig.lend(i);
+        let mut bytes = 0;
+        let ok = unsafe { f.unwrap()(l, a, addrs.as_mut_ptr().cast(), 0, 144, 144, &mut bytes, ov) };
+        if ok != 0 { return Ok(0); }
+        let e = last();
+        if e == WSA_IO_PENDING { Ok(e) } else { rig.unlend(i); Err(e) }
+    }
+
+    fn update_accept(l: SOCKET, a: SOCKET) {
+        assert_eq!(unsafe { setsockopt(a, SOL_SOCKET, SO_UPDATE_ACCEPT_CONTEXT, (&raw const l).cast(), size_of::<SOCKET>() as i32) }, 0, "{}", last());
+    }
+
+    #[test]
+    fn accept_and_accept_ex_share_a_listener() {
+        let mut rig = Rig::new();
+        let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+        let l = raw(&listener);
+        let addr = listener.local_addr().unwrap();
+        listener.set_nonblocking(true).unwrap();
+        rig.associate(l);
+        assert_eq!(accept_on(l).err(), Some(WSAEWOULDBLOCK));
+        let a = socket(false);
+        let mut addrs = Box::new([0u8; 288]);
+        assert_eq!(accept_ex(&mut rig, 0, l, raw(&a), &mut addrs), Ok(WSA_IO_PENDING));
+        rig.only_marks();
+        let c1 = TcpStream::connect(addr).unwrap();
+        let p = rig.packet_of(0);
+        assert_eq!(result(l, p.ov), Ok(0));
+        update_accept(l, raw(&a));
+        nonblocking(raw(&a));
+        rig.associate(raw(&a));
+        assert_eq!(peer_of(raw(&a)), c1.local_addr().unwrap());
+        // 溜まった接続は accept が順に受ける
+        let c2 = TcpStream::connect(addr).unwrap();
+        let c3 = TcpStream::connect(addr).unwrap();
+        for c in [&c2, &c3] {
+            let s = accept_on(l).unwrap();
+            assert_eq!(peer_of(raw(&s)), c.local_addr().unwrap());
+        }
+        assert_eq!(accept_on(l).err(), Some(WSAEWOULDBLOCK));
+        rig.only_marks();
+        // 来ていた接続は AcceptEx が受ける
+        let c4 = TcpStream::connect(addr).unwrap();
+        let b = socket(false);
+        assert!(accept_ex(&mut rig, 1, l, raw(&b), &mut addrs).is_ok());
+        let p = rig.packet_of(1);
+        assert_eq!(result(l, p.ov), Ok(0));
+        update_accept(l, raw(&b));
+        assert_eq!(peer_of(raw(&b)), c4.local_addr().unwrap());
+        rig.only_marks();
+    }
+
+    #[test]
+    fn a_cancelled_accept_ex_ends_aborted() {
+        let mut rig = Rig::new();
+        let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+        let l = raw(&listener);
+        listener.set_nonblocking(true).unwrap();
+        rig.associate(l);
+        let a = socket(false);
+        let mut addrs = Box::new([0u8; 288]);
+        assert_eq!(accept_ex(&mut rig, 0, l, raw(&a), &mut addrs), Ok(WSA_IO_PENDING));
+        assert_ne!(unsafe { CancelIoEx(l as HANDLE, rig.ov(0)) }, 0);
+        let p = rig.packet_of(0);
+        assert_eq!(result(l, p.ov), Err(WSA_OPERATION_ABORTED));
+        drop(a);
+        let c = TcpStream::connect(listener.local_addr().unwrap()).unwrap();
+        let start = Instant::now();
+        let s = loop {
+            match accept_on(l) {
+                Ok(s) => break s,
+                Err(WSAEWOULDBLOCK) if start.elapsed() < LIMIT => thread::yield_now(),
+                Err(e) => panic!("{e}"),
+            }
+        };
+        assert_eq!(peer_of(raw(&s)), c.local_addr().unwrap());
+    }
+
+    /// ConnectEx を出し、終わりの誤りの番号か成功と、かかった時間を返す
+    fn connect_ex(rig: &mut Rig, peer: SocketAddr, rto: bool) -> (OwnedSocket, Result<(), i32>, Duration) {
+        let s = socket(peer.is_ipv6());
+        let any: SocketAddr = if peer.is_ipv6() { "[::]:0" } else { "0.0.0.0:0" }.parse().unwrap();
+        let (local, len) = sockaddr(any);
+        assert_eq!(unsafe { bind(raw(&s), (&raw const local).cast::<SOCKADDR>(), len) }, 0, "{}", last());
+        if rto {
+            let p = TCP_INITIAL_RTO_PARAMETERS { Rtt: TCP_INITIAL_RTO_DEFAULT_RTT as u16, MaxSynRetransmissions: NO_SYN_RETRANSMISSIONS };
+            let mut bytes = 0;
+            let r = unsafe { WSAIoctl(raw(&s), SIO_TCP_INITIAL_RTO, (&raw const p).cast(), size_of::<TCP_INITIAL_RTO_PARAMETERS>() as u32, ptr::null_mut(), 0, &mut bytes, ptr::null_mut(), None) };
+            assert_eq!(r, 0, "{}", last());
+        }
+        nonblocking(raw(&s));
+        rig.associate(raw(&s));
+        let f: LPFN_CONNECTEX = ext(raw(&s), WSAID_CONNECTEX);
+        let (to, len) = sockaddr(peer);
+        let ov = rig.lend(0);
+        let start = Instant::now();
+        let ok = unsafe { f.unwrap()(raw(&s), (&raw const to).cast(), len, ptr::null(), 0, ptr::null_mut(), ov) };
+        let e = if ok != 0 { WSA_IO_PENDING } else { last() };
+        let r = if e == WSA_IO_PENDING {
+            let p = rig.packet_of(0);
+            result(raw(&s), p.ov).map(drop)
+        } else {
+            rig.unlend(0);
+            Err(e)
+        };
+        (s, r, start.elapsed())
+    }
+
+    /// 待ち受けずに bind だけしたソケットの番地。ここへの接続は拒まれ、ソケットを持つ間はほかに取られない
+    fn refusing(ip: &str) -> (OwnedSocket, SocketAddr) {
+        let addr: SocketAddr = (ip.parse::<std::net::IpAddr>().unwrap(), 0).into();
+        let s = socket(addr.is_ipv6());
+        let (raw_addr, len) = sockaddr(addr);
+        assert_eq!(unsafe { bind(raw(&s), (&raw const raw_addr).cast::<SOCKADDR>(), len) }, 0, "{}", last());
+        let mut storage = SOCKADDR_STORAGE::default();
+        let mut n = size_of::<SOCKADDR_STORAGE>() as i32;
+        assert_eq!(unsafe { getsockname(raw(&s), (&raw mut storage).cast(), &mut n) }, 0);
+        // どちらの族でも、ポートは番地の族の欄の直後にある
+        let port = u16::from_be(unsafe { (&raw const storage).cast::<SOCKADDR_IN>().read() }.sin_port);
+        (s, SocketAddr::new(addr.ip(), port))
+    }
+
+    #[test]
+    fn a_refused_loopback_connect_ex_fails_fast() {
+        for ip in ["127.0.0.1", "::1"] {
+            let mut rig = Rig::new();
+            let (_held, to) = refusing(ip);
+            // 送り直しがあれば約 2 秒かかり、`packet_of` の 1 秒の見張りで落ちる
+            let (_, r, took) = connect_ex(&mut rig, to, true);
+            let code = r.unwrap_err();
+            assert!([WSAECONNREFUSED, ERROR_CONNECTION_REFUSED].contains(&code), "{ip}: {code}");
+            eprintln!("{ip}: refused after {took:?}");
+        }
+    }
+
+    #[test]
+    fn a_connect_ex_connects_after_a_bind_to_any() {
+        let mut rig = Rig::new();
+        let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+        let (s, r, _) = connect_ex(&mut rig, listener.local_addr().unwrap(), true);
+        r.unwrap();
+        assert_eq!(unsafe { setsockopt(raw(&s), SOL_SOCKET, SO_UPDATE_CONNECT_CONTEXT, ptr::null(), 0) }, 0, "{}", last());
+        assert_eq!(peer_of(raw(&s)), listener.local_addr().unwrap());
+        let (mut server, _) = listener.accept().unwrap();
+        assert_eq!(unsafe { shutdown(raw(&s), SD_SEND) }, 0);
+        assert_eq!(server.read(&mut [0u8; 8]).unwrap(), 0);
+        rig.only_marks();
+    }
+
+    /// S4 の P-3: 読まない相手への 8 MiB のブロックしない送りが何回で塞がるか
+    #[test]
+    fn large_nonblocking_sends_block_within_eight_calls() {
+        let rig = Rig::new();
+        let (_client, server) = pair(&rig);
+        let chunk = vec![7u8; 8 << 20];
+        let mut taken = Vec::new();
+        loop {
+            match send_on(raw(&server), &chunk) {
+                Ok(n) => taken.push(n),
+                Err(WSAEWOULDBLOCK) => break,
+                Err(e) => panic!("{e}"),
+            }
+            assert!(taken.len() < 8, "no WSAEWOULDBLOCK within 8 sends: {taken:?}");
+        }
+        eprintln!("accepted before WSAEWOULDBLOCK: {taken:?}");
+    }
+
+    /// S4 の P-4: 受けの列が詰まった待ち受けへの接続が、拒まれるか進行中のまま残るか。出力するだけで、どちらかは決めない
+    #[test]
+    fn a_connect_to_a_full_accept_queue_is_refused_or_stays_pending() {
+        let mut rig = Rig::new();
+        let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+        let addr = listener.local_addr().unwrap();
+        let mut fillers = Vec::new();
+        while fillers.len() < 1024 {
+            match TcpStream::connect_timeout(&addr, Duration::from_millis(50)) {
+                Ok(c) => fillers.push(c),
+                Err(_) => break,
+            }
+        }
+        let s = socket(false);
+        let (any, len) = sockaddr("0.0.0.0:0".parse().unwrap());
+        assert_eq!(unsafe { bind(raw(&s), (&raw const any).cast::<SOCKADDR>(), len) }, 0);
+        nonblocking(raw(&s));
+        rig.associate(raw(&s));
+        let f: LPFN_CONNECTEX = ext(raw(&s), WSAID_CONNECTEX);
+        let (to, len) = sockaddr(addr);
+        let ov = rig.lend(0);
+        let ok = unsafe { f.unwrap()(raw(&s), (&raw const to).cast(), len, ptr::null(), 0, ptr::null_mut(), ov) };
+        if ok == 0 && last() != WSA_IO_PENDING {
+            rig.unlend(0);
+            eprintln!("after {} fillers: refused at once ({})", fillers.len(), last());
+            return;
+        }
+        match rig.next(Duration::from_millis(100)) {
+            Some(p) => eprintln!("after {} fillers: ended {:?}", fillers.len(), result(raw(&s), p.ov)),
+            None => {
+                eprintln!("after {} fillers: still pending after 100 ms", fillers.len());
+                assert_ne!(unsafe { CancelIoEx(raw(&s) as HANDLE, ov) }, 0);
+                rig.packet_of(0);
+            }
+        }
+    }
+
+    /// 重なった操作は、出したスレッドが抜けても取り消されない (ポートに結び付いたハンドルの I/O はスレッドに属さない)
+    #[test]
+    fn an_op_outlives_the_thread_that_issued_it() {
+        let mut rig = Rig::new();
+        let (mut client, server) = pair(&rig);
+        let ov = rig.lend(0).expose_provenance();
+        let s = raw(&server);
+        let r = thread::spawn(move || zero_read(s, ptr::with_exposed_provenance_mut(ov))).join().unwrap();
+        assert_eq!(r, Ok(WSA_IO_PENDING));
+        client.write_all(b"a").unwrap();
+        let p = rig.packet_of(0);
+        assert_eq!(result(s, p.ov), Ok(0));
+    }
