+  let r = try_io (fn () -> Async.scope inner)
+  match r with
+    | Ok n -> println "unreachable \{show n}"
+    | Err e -> println "scope: \{show e.kind}: \{e}"
+  let t = Async.start (fn () -> spin 40 + 1)
+  let _ = spin 40
+  Async.await t
+
+main : Unit -> <IO, Panic> Unit
+main () = println (show (Async.run body))
