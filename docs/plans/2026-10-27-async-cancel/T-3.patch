+import Async (Async)
+import MutArray
+
+spin : Int -> <Panic> Int
+spin n = if n == 0 then 0 else spin (n - 1)
+
+forever : Unit -> <IO, Async> Int
+forever () =
+  Async.yield_now ()
+  forever ()
+
+body : Unit -> <IO, Panic, Async> Unit
+body () =
+  let done = Async.start (fn () -> MutArray.make 3 0)
+  let _ = spin 40
+  let t = Async.start (fn () ->
+    match try_io forever with
