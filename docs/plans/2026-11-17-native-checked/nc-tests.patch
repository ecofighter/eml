diff --git a/crates/eml_nrt/examples/fast_only.rs b/crates/eml_nrt/examples/fast_only.rs
new file mode 100644
index 00000000..1f90d4d5
--- /dev/null
+++ b/crates/eml_nrt/examples/fast_only.rs
@@ -0,0 +1,10 @@
+//! EN: Names every fast entry and the fast run driver, and nothing of checked mode.
+use eml_nrt::mode::Fast;
+
+fn main() {
+    let entries = eml_nrt::entries::<Fast>()
+        .map(|entry| (entry.address)() as usize)
+        .fold(0usize, |a, b| a ^ b);
+    let run = eml_nrt::run::run::<Fast> as usize;
+    println!("{}", std::hint::black_box(entries ^ run));
+}
