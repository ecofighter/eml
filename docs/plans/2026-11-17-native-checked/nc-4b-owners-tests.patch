+//! scratch repro: a second checked run on one Control
+#![cfg(not(miri))]
+use eml_native::NativeMachine;
+use eml_nrt::{RunConfig, RuntimeError};
+use eml_test_support::{Engine, execute_finished, native_options};
+
+use crate::common::native::{host, program, unverified};
+
+const LEAK: &str = "\
+layout P { P(int) }
+fn entry$main() -> unit {
+  let u.0: unit = call f(1)
+  return u.0
+}
+fn f(n.0: int) -> unit {
+  let d.1: obj = con P #0(n.0)
+  return ()
+}
+fn clean(n.0: int) -> int {
+  return n.0
+}
+";
+
+const CLEAN: &str = "\
+fn entry$main() -> unit {
+  return ()
+}
+";
+
+const FATAL: &str = "\
+layout P { P(int, int) }
+fn entry$main() -> unit {
+  let r.0: unit = call f(1)
+  return ()
+}
+fn f(n.0: int) -> unit {
+  let k.9: obj = con P #0(n.0, n.0)
+  let d.1: obj = con P #0(n.0, n.0)
+  decref d.1
+  decref d.1
+  decref k.9
+  return ()
+}
+";
+
+fn show(r: Result<eml_nrt::Finished, RuntimeError>) -> String {
+    match r {
+        Ok(f) => format!("ok exit={:?}", f.exit),
+        Err(e) => format!("err {e:?}"),
+    }
+}
+
+#[test]
+fn repro_two_runs_on_one_machine_after_a_leak() {
+    let config = RunConfig::default().with_debug_heap(true);
+    let p = unverified(LEAK);
+    let mut m = NativeMachine::new(&config, host());
+    let loaded = m.load(&p, &eml_test_support::link(&p)).unwrap();
+    eprintln!("REPRO native leak run1: {}", show(m.run(loaded, native_options())));
+    eprintln!("REPRO native leak run2: {}", show(m.run(loaded, native_options())));
+    // SAFETY: `clean` takes an int and returns it
+    let c = unsafe { m.call("clean", &[eml_native::Arg::I64(3)], native_options()) };
+    eprintln!("REPRO native leak call3 (clean fn): {c:?}");
+    m.close();
+    let q = program(CLEAN);
+    eprintln!(
+        "REPRO native execute on the same config after the leak: {}",
+        show(execute_finished(&q, &config, host(), Engine::Native))
+    );
+}
+
+#[test]
+fn repro_execute_twice_after_a_fatal() {
+    let config = RunConfig::default().with_debug_heap(true);
+    let p = unverified(FATAL);
+    eprintln!(
+        "REPRO native fatal run1: {}",
+        show(execute_finished(&p, &config, host(), Engine::Native))
+    );
+    let q = program(CLEAN);
+    eprintln!(
+        "REPRO native clean after fatal, same config: {}",
+        show(execute_finished(&q, &config, host(), Engine::Native))
+    );
+    eprintln!(
+        "REPRO native clean again: {}",
+        show(execute_finished(&q, &config, host(), Engine::Native))
+    );
+}
+
+#[test]
+fn repro_vm_execute_twice() {
+    for (name, text) in [("leak", LEAK), ("fatal", FATAL)] {
+        let config = RunConfig::default().with_debug_heap(true);
+        let p = unverified(text);
+        eprintln!(
+            "REPRO vm {name} run1: {}",
+            show(execute_finished(&p, &config, host(), Engine::Vm))
+        );
+        let q = program(CLEAN);
+        eprintln!(
+            "REPRO vm clean after {name}, same config: {}",
+            show(execute_finished(&q, &config, host(), Engine::Vm))
+        );
+    }
+}
+
+#[test]
+fn control_clean_baseline() {
+    let config = RunConfig::default().with_debug_heap(true);
+    let q = program(CLEAN);
+    for _ in 0..2 {
+        eprintln!(
+            "REPRO baseline clean: {}",
+            show(execute_finished(&q, &config, host(), Engine::Native))
+        );
+    }
+}
+
+/// The table's counts as a fresh checked heap on the same Control sees them.
+fn table(config: &RunConfig) -> Vec<u64> {
+    let heap = eml_rt::Heap::<eml_rt::Checked>::with_control(config.control.clone());
+    (0..4).map(|id| heap.owned_by(id)).collect()
+}
+
+#[test]
+fn probe_counts_left() {
+    for (name, text) in [("leak", LEAK), ("fatal", FATAL)] {
+        for engine in [Engine::Native, Engine::Vm] {
+            let config = RunConfig::default().with_debug_heap(true);
+            eprintln!("PROBE {name} before: {:?}", table(&config));
+            let p = unverified(text);
+            let r = show(execute_finished(&p, &config, host(), engine));
+            eprintln!("PROBE {name} {r} after: owned_by(0..4) = {:?}", table(&config));
+        }
+    }
+    let config = RunConfig::default().with_debug_heap(true);
+    let q = program(CLEAN);
+    let r = show(execute_finished(&q, &config, host(), Engine::Native));
+    eprintln!("PROBE clean {r} after: {:?}", table(&config));
+}
