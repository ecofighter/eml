+// ---- adversarial probes against "subtract at drop" ----
+
+/// A1: a destructor that panics during the drop walk leaves the blocks after it in the table.
+#[test]
+fn adv_a_panicking_finalizer_during_drop_leaves_counts() {
+    let control = Arc::new(Control::new(Limits::default()));
+    let mut heap = Heap::<Checked>::with_control(control.clone());
+    let panics = Arc::new(AtomicUsize::new(0));
+    let _first = heap.alloc_foreign(Panicker(panics.clone()), false);
+    let _rest = list(&mut heap, 5);
+    let before = heap.owned_by(0);
+    let result = catch_unwind(AssertUnwindSafe(move || drop(heap)));
+    let mut next = Heap::<Checked>::with_control(control.clone());
+    eprintln!(
+        "ADV A1: drop panicked={} before={} left owned_by(0)={} check={:?}",
+        result.is_err(),
+        before,
+        next.owned_by(0),
+        super::check_all(&mut next)
+    );
+}
+
+/// A1b: the same inside recovery: the old heap's drop unwinds out of `recover`.
+#[test]
+fn adv_a_panicking_finalizer_during_recovery() {
+    let mut ctx = ctx_tests::ctx::<Checked>();
+    let panics = Arc::new(AtomicUsize::new(0));
+    unsafe {
+        let heap = ctx.heap_mut();
+        let _first = heap.alloc_foreign(Panicker(panics.clone()), false);
+        let _rest = list(heap, 5);
+        let kept = list(heap, 2);
+        ctx.root_set(0, kept).unwrap();
+    }
+    let result = catch_unwind(AssertUnwindSafe(|| unsafe { ctx.recover() }));
+    eprintln!(
+        "ADV A1b: recover panicked={} owned_by(0)={} check={:?}",
+        result.is_err(),
+        ctx.heap().owned_by(0),
+        super::check_all(&mut ctx)
+    );
+}
+
+/// A3: IDs are forgotten by recovery while another heap of the abandoned run still holds
+/// objects of a forked ID; an ID issued before that heap is dropped inherits their count.
+#[test]
+fn adv_an_id_reissued_before_the_other_heap_is_dropped() {
+    let control = Arc::new(Control::new(Limits::default()));
+    let mut ctx = Ctx::<Checked>::for_worker(control.clone(), host(&Arc::new(MemoryHost::default())), 0);
+    let mut other = Heap::<Checked>::with_owners(control.clone(), &ctx.heap().owners());
+    let child = unsafe { ctx.heap_mut() }.fork_worker();
+    other.set_worker(child);
+    let _lost = list(&mut other, 3);
+    unsafe { ctx.recover() }.unwrap();
+    let again = unsafe { ctx.heap_mut() }.fork_worker();
+    let retire = unsafe { ctx.heap_mut() }.retire_worker(again);
+    eprintln!("ADV A3: child={child} reissued={again} retire={retire:?}");
+    drop(other);
+}
+
+/// A11: a run that ends without retiring its IDs leaves them issued for good.
+#[test]
+fn adv_ids_of_a_dropped_heap_stay_issued() {
+    let control = Arc::new(Control::new(Limits::default()));
+    let mut ids = Vec::new();
+    for _ in 0..3 {
+        let mut heap = Heap::<Checked>::with_control(control.clone());
+        let id = heap.fork_worker();
+        heap.set_worker(id);
+        let _lost = list(&mut heap, 2);
+        ids.push(id);
+    }
+    eprintln!("ADV A11: forked ids over three abandoned heaps = {ids:?}");
+}
