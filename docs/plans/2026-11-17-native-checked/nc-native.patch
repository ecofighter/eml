diff --git a/crates/eml_native/src/lower/audit.rs b/crates/eml_native/src/lower/audit.rs
new file mode 100644
index 00000000..9e2e31f4
--- /dev/null
+++ b/crates/eml_native/src/lower/audit.rs
@@ -0,0 +1,149 @@
+//! EN: The audits of checked lowering (docs/spec/native.md 「検査モード」). Checked lowering emits the same inline memory
+//! access as fast lowering, preceded by one call of the audit entry for that access. Every module of `lower/` that names
+//! a `mem::` access helper emits its audits through `emit` here, and fast lowering emits nothing.
+use cranelift_codegen::ir::{FuncRef, InstBuilder, MemFlagsData, Value, types};
+use cranelift_frontend::FunctionBuilder;
+use cranelift_module::Module;
+
+use super::Imports;
+use super::function::FnLower;
+use super::rc::Step;
+use crate::mem;
+
+/// EN: One audit. The object word is passed beside it.
+#[derive(Clone, Copy)]
+pub(super) enum Audit {
+    /// EN: Before a load of the field at `position` of an object with `scanned` scanned words.
+    Load { scanned: u32, position: u32 },
+    /// EN: Before a store of `value` into that field.
+    Store {
+        scanned: u32,
+        position: u32,
+        value: Value,
+    },
+    /// EN: Before `load_rc` + `is_one_ref`.
+    Unique,
+    /// EN: Before `load_meta`, `load_tag` or `is_big_int`.
+    Header,
+    /// EN: Before `load_meta` + `closure_code` of a function value and the indirect call of that code. `expect` is the signature word the call uses, or `CODE_OF_TAG`.
+    Code { expect: i64 },
+    /// EN: Before `load_box`.
+    Boxed { float: bool },
+    /// EN: Before the field loads of a statement that names a constructor.
+    Data { tag: u32, scanned: u32 },
+}
+
+/// EN: The audit entry before the inline count step of `step`.
+pub(super) fn count_entry(step: Step) -> &'static str {
+    match step {
+        Step::Dup => "eml_rt_audit_dup",
+        Step::Decref => "eml_rt_audit_decref",
+    }
+}
+
+/// EN: Emits the call of the count audit `audit` on `obj`; fast lowering passes `None`.
+pub(super) fn call_before(b: &mut FunctionBuilder, ctx: Value, audit: Option<FuncRef>, obj: Value) {
+    if let Some(audit) = audit {
+        b.ins().call(audit, &[ctx, obj]);
+    }
+}
+
+/// EN: The entry and its arguments after `ctx`.
+fn call(b: &mut FunctionBuilder, obj: Value, audit: Audit) -> (&'static str, Vec<Value>) {
+    let word = |b: &mut FunctionBuilder, n: i64| b.ins().iconst(types::I64, n);
+    match audit {
+        Audit::Load { scanned, position } => {
+            let index = word(b, mem::field_index(scanned, position) as i64);
+            let entry = if position < scanned {
+                "eml_rt_audit_field"
+            } else {
+                "eml_rt_audit_raw"
+            };
+            (entry, vec![obj, index])
+        }
+        Audit::Store {
+            scanned,
+            position,
+            value,
+        } => {
+            let index = word(b, mem::field_index(scanned, position) as i64);
+            if position < scanned {
+                ("eml_rt_audit_store", vec![obj, index, value])
+            } else {
+                let bits = if b.func.dfg.value_type(value) == types::F64 {
+                    b.ins().bitcast(types::I64, MemFlagsData::new(), value)
+                } else {
+                    value
+                };
+                ("eml_rt_audit_store_raw", vec![obj, index, bits])
+            }
+        }
+        Audit::Unique => ("eml_rt_audit_unique", vec![obj]),
+        Audit::Header => ("eml_rt_audit_header", vec![obj]),
+        Audit::Code { expect } => {
+            let expect = word(b, expect);
+            ("eml_rt_audit_code", vec![obj, expect])
+        }
+        Audit::Boxed { float } => {
+            let float = word(b, i64::from(float));
+            ("eml_rt_audit_box", vec![obj, float])
+        }
+        Audit::Data { tag, scanned } => {
+            let tag = word(b, i64::from(tag));
+            let scanned = word(b, i64::from(scanned));
+            ("eml_rt_audit_data", vec![obj, tag, scanned])
+        }
+    }
+}
+
+/// EN: Emits `audit` of `obj` in checked lowering, and nothing in fast lowering.
+pub(super) fn emit<M: Module>(
+    b: &mut FunctionBuilder,
+    module: &mut M,
+    imports: &Imports,
+    ctx: Value,
+    obj: Value,
+    audit: Audit,
+) {
+    if !imports.checked {
+        return;
+    }
+    let (symbol, mut args) = call(b, obj, audit);
+    let callee = module.declare_func_in_func(imports.entry(symbol), b.func);
+    args.insert(0, ctx);
+    b.ins().call(callee, &args);
+}
+
+/// EN: Emits one count of the worker's counter `which` in checked lowering.
+pub(super) fn count<M: Module>(
+    b: &mut FunctionBuilder,
+    module: &mut M,
+    imports: &Imports,
+    ctx: Value,
+    which: i64,
+) {
+    if !imports.checked {
+        return;
+    }
+    let callee = module.declare_func_in_func(imports.entry("eml_rt_audit_count"), b.func);
+    let which = b.ins().iconst(types::I64, which);
+    b.ins().call(callee, &[ctx, which]);
+}
+
+impl<M: Module> FnLower<'_, '_, M> {
+    pub(super) fn audit(&mut self, obj: Value, audit: Audit) {
+        if !self.imports.checked {
+            return;
+        }
+        let (symbol, args) = call(&mut self.b, obj, audit);
+        self.call_entry(symbol, &args);
+    }
+
+    pub(super) fn count(&mut self, which: i64) {
+        if !self.imports.checked {
+            return;
+        }
+        let which = self.b.ins().iconst(types::I64, which);
+        self.call_entry("eml_rt_audit_count", &[which]);
+    }
+}
