+/// EN: The signature word (`eml_nrt::image::sig_word`) of the entry of a closure of `function` with `captures` captures.
+pub fn closure_entry_sig_word(function: &LirFn, captures: usize) -> u64 {
+    sig_word(&lower::params(function)[captures..], &lower::rets(function))
+}
+
+/// EN: The signature word of a clause call of `op` of `effect`.
+pub fn clause_sig_word(program: &Program, effect: u32, op: u32) -> i64 {
+    let operation = &program.effects[effect as usize].operations[op as usize];
+    let mut params = vec![Kind::I64];
+    params.extend(operation.params.iter().map(|&repr| lower::kind(repr)));
+    let ret = match operation.ret {
+        OpRet::Repr(repr) => lower::kind(repr),
+        OpRet::Never => Kind::I64,
+    };
+    sig_word(&params, &[ret]) as i64
+}
+
+fn sig_word(params: &[Kind], rets: &[Kind]) -> u64 {
+    let [ret] = rets else {
+        panic!("a function value's entry returns one value")
+    };
+    eml_nrt::image::sig_word(params, *ret)
+        .expect("an entry signature has a float only among its first 47 parameters")
+}
+
