+//! EN: What the run driver does differently in each mode: the checks at the end of a run and the counters of `RunStats`
+//! (docs/spec/native.md 「検査モード」). This is the only module of the crate that names `Fast` and `Checked`.
+pub use eml_rt::{Checked, Fast};
+use eml_rt::{Ctx, Mode};
+use eml_sched::config::RunStats;
+use eml_sched::error::{RunFault, RuntimeError};
+
+use crate::census::census;
+use crate::image::Census;
+use crate::worker::{
+    COUNT_BOXES, COUNT_REUSES, COUNT_UNBOXES, COUNT_UNWOUND_FRAMES, NATIVE_CODE, Worker,
+};
+
+/// EN: A mode native code can run in.
+pub trait Engine: Mode + Sized {
+    /// EN: The checks after a successful run.
+    fn end(ctx: &mut Ctx<Self>, census: Census) -> Result<(), RuntimeError>;
+    /// EN: The counters of the run. Fast mode counts nothing.
+    fn stats(ctx: &Ctx<Self>, worker: &Worker) -> RunStats;
+}
+
+impl Engine for Fast {
+    fn end(ctx: &mut Ctx<Fast>, option: Census) -> Result<(), RuntimeError> {
+        if option == Census::Check {
+            let left = census(ctx);
+            if !left.is_empty() {
+                return Err(RuntimeError::Leak(left));
+            }
+        }
+        Ok(())
+    }
+
+    fn stats(_ctx: &Ctx<Fast>, _worker: &Worker) -> RunStats {
+        RunStats::default()
+    }
+}
+
+impl Engine for Checked {
+    // EN: Inlined, so that the code exists only in a crate that instantiates checked mode
+    #[inline]
+    fn end(ctx: &mut Ctx<Checked>, _census: Census) -> Result<(), RuntimeError> {
+        let fault = |error: eml_rt::HeapError| RuntimeError::Fault {
+            fault: RunFault::from(error),
+            function: NATIVE_CODE.to_string(),
+            at: None,
+        };
+        ctx.check_invariants().map_err(fault)?;
+        ctx.heap()
+            .control()
+            .check_owned(&[ctx.heap()])
+            .map_err(fault)?;
+        let leaks = ctx.leaks();
+        if leaks.is_empty() {
+            Ok(())
+        } else {
+            Err(RuntimeError::Leak(
+                leaks
+                    .into_iter()
+                    .map(|(name, n)| (name.to_string(), n))
+                    .collect(),
+            ))
+        }
+    }
+
+    #[inline]
+    fn stats(ctx: &Ctx<Checked>, worker: &Worker) -> RunStats {
+        let c = ctx.stats();
+        let h = ctx.heap().stats();
+        RunStats {
+            evidence_steps: c.evidence_steps,
+            yields: c.yields,
+            yield_frames: c.yield_frames,
+            unwound_frames: worker.counts[COUNT_UNWOUND_FRAMES as usize],
+            string_bytes_copied: c.string_bytes_copied,
+            rc_increments: h.rc_increments,
+            rc_decrements: h.rc_decrements,
+            boxes: worker.counts[COUNT_BOXES as usize],
+            unboxes: worker.counts[COUNT_UNBOXES as usize],
+            allocations: h.allocations,
+            reuses: worker.counts[COUNT_REUSES as usize],
+            peak_objects: h.peak_live,
+            shared_objects: h.shared,
+            ..RunStats::default()
+        }
+    }
+}
+
+/// EN: The entry table of a mode chosen at run time. Only the JIT host calls this; an ahead-of-time program names the
+/// fast entries by symbol.
+pub fn entries_in(checked: bool) -> Vec<&'static crate::Entry> {
+    if checked {
+        crate::entries::<Checked>().collect()
+    } else {
+        crate::entries::<Fast>().collect()
+    }
+}
+
+/// EN: `run::run` in a mode chosen at run time.
+///
+/// # Safety
+/// EN: As `run::run`, and the code of `image` was lowered for that mode against `entries_in(checked)`.
+#[allow(unsafe_code)]
+pub unsafe fn run_in(
+    checked: bool,
+    image: &crate::image::Image,
+    start: &crate::image::Start,
+    config: &crate::RunConfig,
+    host: crate::HostRef,
+    options: crate::image::Options,
+) -> Result<crate::Finished, RuntimeError> {
+    // SAFETY: EN: the caller's promise
+    unsafe {
+        if checked {
+            crate::run::run::<Checked>(image, start, config, host, options)
+        } else {
+            crate::run::run::<Fast>(image, start, config, host, options)
+        }
+    }
+}
