+/// EN: The word of an entry signature `tail (ctx, clo, params..) -> ret`: the number of `params`, bit 16 for an `F64` result and bit `17 + i` for an `F64` parameter `i`. The uniform signature of `n` arguments is the word `n`. `None` when a parameter past the 46th is an `F64`.
+pub fn sig_word(params: &[crate::Kind], ret: crate::Kind) -> Option<u64> {
+    let mut word = u64::try_from(params.len()).ok().filter(|&n| n < 1 << 16)?;
+    if ret == crate::Kind::F64 {
+        word |= 1 << 16;
+    }
+    for (i, &kind) in params.iter().enumerate() {
+        if kind == crate::Kind::F64 {
+            if i > 46 {
+                return None;
+            }
+            word |= 1 << (17 + i);
+        }
+    }
+    Some(word)
+}
