+/// EN: Runs `src` in fast mode on two workers and returns the bytes of the pages worker 0's heap holds after the run. The other workers' heaps are dropped after a successful run and pages of small objects are never returned, so the value is the most pages worker 0 held (docs/spec/object-model.md 「確保と解放」).
+fn pages_of_worker_0(src: &str, stdout: &str) -> usize {
+    let program = eml_test_support::lir(src);
+    let control = limits(2);
+    let (host, out) = eml_vm::capture_host(Default::default());
+    let mut machine = Machine::<eml_rt::Fast>::new(Arc::clone(&control), host);
+    let entry = machine.load(&program, &eml_vm::Linked::default()).unwrap();
+    machine.run(entry).unwrap_or_else(|error| panic!("{error}"));
+    assert_eq!(out.contents(), stdout);
+    let bytes = control.bytes();
+    drop(machine);
+    bytes
+}
+
+/// EN: A task that hands off items with `Chan.try_send` never switches. The receiver on the other worker drops each item and then counts it, and the sender waits for the count before the next item, so every free has arrived at the next hand-off. The sender takes them in before it marks the next item, so its pages do not grow with the number of items (docs/spec/object-model.md 「別のスレッドからの解放」).
+#[test]
+fn a_try_send_loop_takes_in_the_frees_of_its_receiver() {
+    let src = "\
+import Async (Async)
+import Async
+import Chan
+import Atomic
+import Array
+consume : Chan.Chan (Array Int) -> Atomic.Counter -> <IO, Panic, Async> Unit
+consume c k =
+  match Chan.recv c with
+    | Some a ->
+      drop a
+      let _ = Atomic.add 1 k
+      consume c k
+    | None -> ()
+push : Array Int -> Chan.Chan (Array Int) -> <IO, Panic> Unit
+push a c =
+  match Chan.try_send a c with
+    | Chan.Accepted -> ()
+    | Chan.Full a -> push a c
+    | Chan.Refused a -> ()
+wait : Int -> Atomic.Counter -> <IO> Unit
+wait i k = if Atomic.load k >= i then () else wait i k
+produce : Int -> Int -> Chan.Chan (Array Int) -> Atomic.Counter -> <IO, Panic> Unit
+produce i n c k =
+  if i == n then ()
+  else
+    push (Array.make 100 i) c
+    wait (i + 1) k
+    produce (i + 1) n c k
+main : Unit -> <IO, Panic, Async> Unit
+main () =
+  let c = Chan.new 4
+  let k = Atomic.new 0
+  let t = Async.start (fn () -> consume c k)
+  produce 0 20000 c k
+  Chan.close c
+  Async.await t
+  println (show (Atomic.load k))
+";
+    let bytes = pages_of_worker_0(src, "20000\n");
+    assert!(bytes < 4 << 20, "{bytes}");
+    // EN: The same loop, shorter, ends cleanly in checked mode: the audits at the end of the run see the heaps after the reclaims at the hand-offs.
+    let (out, result) = run(&src.replace("20000", "600"), 2);
+    result.unwrap_or_else(|error| panic!("{error}"));
+    assert_eq!(out, "600\n");
+}
+
+/// EN: The same with `Async.spawn`: each task drops the array its closure holds and then counts it.
+#[test]
+fn a_spawn_loop_takes_in_the_frees_of_its_tasks() {
+    let src = "\
+import Async (Async)
+import Async
+import Atomic
+import Array
+wait : Int -> Atomic.Counter -> <IO> Unit
+wait i k = if Atomic.load k >= i then () else wait i k
+work : Array Int -> Atomic.Counter -> <IO> Unit
+work a k =
+  drop a
+  let _ = Atomic.add 1 k
+  ()
+produce : Int -> Int -> Atomic.Counter -> <IO, Panic, Async> Unit
+produce i n k =
+  if i == n then ()
+  else
+    let a = Array.make 100 i
+    Async.spawn (fn () -> work a k)
+    wait (i + 1) k
+    produce (i + 1) n k
+main : Unit -> <IO, Panic, Async> Unit
+main () =
+  let k = Atomic.new 0
+  produce 0 20000 k
+  println (show (Atomic.load k))
+";
+    let bytes = pages_of_worker_0(src, "20000\n");
+    assert!(bytes < 4 << 20, "{bytes}");
+    // EN: The same loop, shorter, ends cleanly in checked mode: the audits at the end of the run see the heaps after the reclaims at the hand-offs.
+    let (out, result) = run(&src.replace("20000", "600"), 2);
+    result.unwrap_or_else(|error| panic!("{error}"));
+    assert_eq!(out, "600\n");
+}
