+// EN: A large page freed by another heap does not count toward the walk of the pages: with 255 small blocks waiting, a large free makes `reclaim_if_due` take the large page only, and the 256th small block makes it walk.
+fn large_frees_do_not_count_toward_the_walk<M: Mode>() {
+    let (mut a, mut b) = pushed::<M>(255);
+    let big = a.alloc_data(0, 0, 4096, false);
+    unsafe {
+        a.share(big, 0).unwrap();
+        b.decref(big).unwrap();
+    }
+    assert!(a.reclaim_if_due());
+    if M::CHECKED {
+        assert_eq!(a.stats().reclaimed, 1);
+    }
+    assert!(!a.reclaim_if_due());
+    let x = list(&mut a, 1);
+    unsafe {
+        a.share(x, 0).unwrap();
+        b.decref(x).unwrap();
+    }
+    assert!(a.reclaim_if_due());
+    if M::CHECKED {
+        assert_eq!(a.stats().reclaimed, 257);
+    }
+    assert!(!a.reclaim_if_due());
+    assert_eq!(mortal(&mut a), 0);
+}
