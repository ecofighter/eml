@@ -0,0 +1,21 @@
+-- EN: The input of `Par.map` holds boxed elements the parent made. The forks mark the array and its elements as shared, so children on other workers read them, and the parent uses the input again after the join (docs/spec/vm.md 「`par` の fork と join」).
+import Std.Array
+import Std.Par
+
+upto : Int -> List Int -> <Panic> List Int
+upto n acc = if n == 0 then acc else upto (n - 1) (n :: acc)
+
+sum : List Int -> <Panic> Int
+sum xs =
+  match xs with
+    | [] -> 0
+    | x :: rest -> x + sum rest
+
+main : Unit -> <IO, Panic> Unit
+main () =
+  let lists = Array.tabulate 3000 (fn i -> upto (i % 7) [])
+  let sums = Par.map sum lists
+  let longer = Par.mapi (fn i xs -> i :: xs) lists
+  println (show (Par.reduce (fn a b -> a + b) 0 sums))
+  println (show (Array.get longer 2999, Array.get lists 2999))
+  println (show (sum (Array.get lists 6) + Array.length longer))
diff --git a/tests/ui/run/par/reduce_float_bits.em b/tests/ui/run/par/reduce_float_bits.em
