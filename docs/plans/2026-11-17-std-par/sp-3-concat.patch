+-- EN: A joined length the allocator cannot make ends the run with the memory limit error, as `Array.make` does; `try_panic` does not catch it (docs/spec/stdlib.md 「`Std.Array`」).
+import Array
+
+main : Unit -> <IO, Panic> Unit
+main () =
+  let chunk = Array.make 65536 0
+  match try_panic (fn () -> Array.length (Array.concat (Array.make 65536 chunk))) with
+    | Ok n -> println "unreachable \{show n}"
+    | Err m -> println "unreachable: \{m}"
