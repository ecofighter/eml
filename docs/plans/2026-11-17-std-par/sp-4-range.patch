+-- EN: Every chunk runs to its end or to its own `Panic`, and the `Panic` of the smallest index is raised again: `par` raises the left child's first, and the left child holds the smaller indexes at both levels of the split. An empty range calls nothing (docs/spec/stdlib.md 「`Std.Par`」).
+import Std.Par
+
+main : Unit -> <IO, Panic> Unit
+main () =
+  println (show (try_panic (fn () -> Par.for_range 0 5000 (fn i -> if i == 4000 || i == 2500 then panic "at \{show i}" else ()))))
+  println (show (try_panic (fn () -> Par.reduce_range (fn a b -> a + b) 0 0 5000 (fn i -> 10 / (i - 3000)))))
+  println (show (try_panic (fn () -> Par.reduce_range_grain 10 (fn a b -> if a + b > 100 then panic "join \{show a} \{show b}" else a + b) 0 0 40 (fn i -> i))))
+  Par.for_range 0 3000 (fn i -> if i < 0 then panic "negative" else ())
+  Par.for_range_grain 100 0 1000 (fn _ -> ())
+  Par.for_range 5 5 (fn _ -> panic "empty")
+  println (show (Par.reduce_range (fn a b -> a + b) 7 5 5 (fn i -> i)))
+  println (show (Par.reduce_range (fn a b -> a + b) 7 0 5000 (fn i -> i)))
diff --git a/tests/ui/run/par/spine_shape.em b/tests/ui/run/par/spine_shape.em
new file mode 100644
index 00000000..7c331650
--- /dev/null
+++ b/tests/ui/run/par/spine_shape.em
@@ -0,0 +1,32 @@
+-- EN: The shape of the split depends only on the length and the grain: chunks of `grain` indexes, groups of `ceil(sqrt(chunks))` chunks, and a left-nested join at both levels. A join that writes parentheses shows the shape (docs/spec/stdlib.md 「`Std.Par`」).
+import Std.Par
+
+shape : Int -> Int -> Int -> <Panic> String
+shape grain lo hi = Par.reduce_range_grain grain (fn l r -> "(\{l} \{r})") "empty" lo hi (fn i -> show i)
+
+data Span =
+  | Run Int Int
+  | Fork Span Span
+
+-- EN: Joins inside a chunk extend a run; a join at a chunk boundary (an index that is a multiple of 1024) or of two joined parts makes a fork.
+join : Span -> Span -> <Panic> Span
+join l r =
+  match (l, r) with
+    | (Run a b, Run c d) -> if c == d && c % 1024 != 0 then Run a d else Fork l r
+    | _ -> Fork l r
+
+render : Span -> String
+render s =
+  match s with
+    | Run a b -> "\{show a}..\{show b}"
+    | Fork l r -> "(\{render l} \{render r})"
+
+main : Unit -> <IO, Panic> Unit
+main () =
+  println (shape 2 0 0)
+  println (shape 2 0 1)
+  println (shape 2 0 7)
+  println (shape 2 10 31)
+  println (shape 1 0 5)
+  println (render (Par.reduce_range join (Run 0 0) 0 5000 (fn i -> Run i i)))
+  println (show (try_panic (fn () -> shape 0 0 3)))
