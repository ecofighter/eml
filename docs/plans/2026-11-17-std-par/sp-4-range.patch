+-- EN: The number of indexes in a chunk for the functions without `_grain` (docs/spec/stdlib.md 「`Std.Par`」).
+grain : Int
+grain = 1024
+
+-- EN: The smallest `b` at or above the given one with `b * b >= n`.
+root : Int -> Int -> <Panic> Int
+root n b = if b * b >= n then b else root n (b + 1)
+
+-- EN: Splits the non-empty range from `lo` up to `hi` as a two-level spine. The range is cut into chunks of `size` indexes and the chunks into groups of `width` chunks, `width` being the square root of the number of chunks, rounded up. The top level gives `par` every earlier group and the last group; a group gives it every earlier chunk and its last chunk. `leaf` computes a chunk from its bounds and `join` combines two neighbours, the left one first, so the joins nest to the left at both levels. The shape depends only on the length and `size`, not on the workers or on which child another worker took.
+spine : Int -> Int -> Int -> (Int -> Int -> <Panic> a) -> (a -> a -> <Panic> a) -> <Panic> a
+spine size lo hi leaf join =
+  let chunks = if size < 1 then panic "Par: the grain is less than 1" else (hi - lo - 1) / size + 1
+  let width = root chunks 1
+  let chunk k = leaf (lo + k * size) (if k + 1 == chunks then hi else lo + (k + 1) * size)
+  let group first last =
+    if first == last then
+      chunk first
+    else
+      let (rest, tail) = par (fn () -> group first (last - 1)) (fn () -> chunk last)
+      join rest tail
+  let top g =
+    let first = g * width
+    let last = if first + width < chunks then first + width - 1 else chunks - 1
+    if g == 0 then
+      group first last
+    else
+      let (rest, tail) = par (fn () -> top (g - 1)) (fn () -> group first last)
+      join rest tail
+  top ((chunks - 1) / width)
+
+-- EN: Joins `f i` for the indexes from `lo` up to `hi` in the order of the spine: a chunk folds its indexes from the left, starting from its first one. An empty range gives `unit`, which is not used otherwise.
+pub reduce_range_grain : Int -> (a -> a -> <Panic> a) -> a -> Int -> Int -> (Int -> <Panic> a) -> <Panic> a
+reduce_range_grain size join unit lo hi f =
+  let fold i end acc = if i == end then acc else fold (i + 1) end (join acc (f i))
+  if lo < hi then spine size lo hi (fn a b -> fold (a + 1) b (f a)) join else unit
+
+pub reduce_range : (a -> a -> <Panic> a) -> a -> Int -> Int -> (Int -> <Panic> a) -> <Panic> a
+reduce_range join unit lo hi f = reduce_range_grain grain join unit lo hi f
+
+-- EN: Calls `body i` for the indexes from `lo` up to `hi`: in index order inside a chunk, in no fixed order between chunks.
+pub for_range_grain : Int -> Int -> Int -> (Int -> <Panic> Unit) -> <Panic> Unit
+for_range_grain size lo hi body =
+  if lo < hi then spine size lo hi (fn a b -> for a b body) (fn () () -> ()) else ()
+
+pub for_range : Int -> Int -> (Int -> <Panic> Unit) -> <Panic> Unit
+for_range lo hi body = for_range_grain grain lo hi body
