@@ -0,0 +1,26 @@
+-- EN: `Par.tabulate_unboxed` of `Float` elements computed from the index. The size is an argument (default 8192, eight chunks); the count test runs it at two sizes and reads the allocations per element from the difference (docs/implementation/benchmarks.md 「`Par.tabulate_unboxed` の `Float` の箱」).
+import Std.Env
+import Std.Float
+import Std.Par
+import Std.String
+import Std.UnboxedArray
+
+main : Unit -> <IO, Panic> Unit
+main () =
+  let n = size 8192
+  let xs = Par.tabulate_unboxed n (fn i -> Float.of_int i * 0.5)
+  println (Float.to_fixed 1 (UnboxedArray.get xs (n - 1)))
+
+-- EN: Without an argument the default size is used.
+size : Int -> <IO, Panic> Int
+size default =
+  match Env.args () with
+    | Nil -> default
+    | [arg] ->
+      match String.to_int arg with
+        | Some n -> if n >= 1 then n else usage ()
+        | None -> usage ()
+    | _ -> usage ()
+
+usage : Unit -> <Panic> Int
+usage () = panic "usage: par_tabulate_float [SIZE]"
