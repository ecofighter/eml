+-- EN: The unboxed side of the pair with `par_map.em`: `Par.for_mut_unboxed` with the same cheap function over a `MutUnboxedArray Int` of 100 000 elements. Every pass copies the array once through `UnboxedArray.concat` (docs/implementation/benchmarks.md 「プログラム」).
+import Std.MutUnboxedArray
+import Std.Par
+import Std.UnboxedArray
+
+main : Unit -> <IO, Panic> Unit
+main () =
+  let xs = UnboxedArray.thaw (Par.tabulate_unboxed 100000 (fn i -> i))
+  let ys = MutUnboxedArray.freeze (Par.for_mut_unboxed (fn _ x -> x + 1) xs)
+  println (show (UnboxedArray.get ys 0 + UnboxedArray.get ys 99999 + UnboxedArray.length ys))
