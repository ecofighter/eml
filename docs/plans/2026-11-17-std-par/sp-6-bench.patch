+-- EN: `Par.map` with a cheap function over a boxed `Array Int` of 100 000 elements (98 chunks, 97 forks), then `Par.reduce` to print the sum. The row is the boxed side of the pair with `par_map_unboxed.em`: the chunks are joined by `Array.concat`, which takes one reference per element (docs/implementation/benchmarks.md 「プログラム」).
+import Std.Array
+import Std.Par
+
+main : Unit -> <IO, Panic> Unit
+main () =
+  let xs = Par.tabulate 100000 (fn i -> i)
+  let ys = Par.map (fn x -> x + 1) xs
+  println (show (Array.get ys 0 + Array.get ys 99999 + Array.length ys))
