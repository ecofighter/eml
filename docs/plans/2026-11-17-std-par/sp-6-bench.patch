+-- EN: `Par.reduce_range` of a `Float` sum over 100 000 indexes (98 chunks, 97 forks). No array is built, so the row is the cost of the spine and of the callbacks (docs/implementation/benchmarks.md 「プログラム」).
+import Std.Float
+import Std.Par
+
+main : Unit -> <IO, Panic> Unit
+main () =
+  let sum = Par.reduce_range (fn a b -> a + b) 0.0 0 100000 (fn i -> 1.0 / Float.of_int (i + 1))
+  println (Float.to_fixed 9 sum)
