+        }
+        Ok(match self.chan_of(CellRef::decode(c)) {
+            None => 2,
+            Some(ch) if ch.closed => 2,
+            Some(ch) if ch.can_send() => 0,
+            Some(_) => 1,
+        })
+    }
+
+    pub(crate) fn reserve_recv(&mut self, c: i64, me: Option<CellRef>, yields: bool) -> Result<i64, CellFault> {
+        if self.spend(me, yields)? {
+            return Ok(3);
+        }
+        Ok(match self.chan_of(CellRef::decode(c)) {
+            None => 2,
+            Some(ch) if !ch.items.is_empty() => 0,
+            Some(ch) if ch.closed => 2,
+            Some(_) => 1,
