# 前の入力の channel は、閉じて空の channel として振る舞う。閉じていない channel も run の終わりに放すためである。
# 後の入力の channel が同じ添字を使っても、generation が違うので前の値はその channel を指さない
# (docs/spec/stdlib.md の「`Std.Chan`」、docs/spec/modules.md の「REPL のセッション」)
> import Async
> import Chan
> let c : Chan.Chan Int = Async.run (fn () -> Chan.new 1)
> println (show (Chan.try_send 1 c))
> println (show (Chan.try_recv c))
> Async.run (fn () -> println (show (Chan.send 2 c)))
> Async.run (fn () -> println (show (Chan.recv c)))
> Chan.close c
> probe : Chan.Chan Int -> Chan.Chan Int -> <IO> Unit
. probe old live =
.   let _ = Chan.try_send 5 live
.   println "\{show (Chan.try_recv old)} \{show (Chan.try_recv live)}"
.
> probe c (Chan.new 1)
