 #[test]
 fn every_program_lowers_to_the_same_text() {
-    for program in ui_programs() {
-        let core = eml_test_support::core_until_files(
-            &program.entry,
-            &program.module_refs(),
-            Pass::Evidence,
-        );
-        let shown = pretty_with_positions(&core);
