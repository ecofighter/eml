+pub fn for_each_file(root: &Path, extension: &str, test: impl Fn(&Path) + Sync) {
+    let mut files = Vec::new();
+    collect(root, extension, &mut files);
+    files.sort();
+    assert!(!files.is_empty(), "no .{extension} file under {}", root.display());
+    if let Ok(filter) = std::env::var("EML_UI_FILTER") {
+        assert_filter_matches(&filter);
+        files.retain(|path| shown(path).contains(&filter));
+    }
+    let slow = Duration::from_secs_f64(
+        std::env::var("EML_SLOW_SECS").ok().and_then(|s| s.parse().ok()).unwrap_or(SLOW_DEFAULT),
+    );
+    let threads = std::env::var("RUST_TEST_THREADS")
+        .ok()
+        .and_then(|n| n.parse().ok())
+        .unwrap_or_else(|| std::thread::available_parallelism().map_or(1, usize::from))
+        .min(files.len());
+    let next = AtomicUsize::new(0);
+    let failures = Mutex::new(Vec::new());
+    let running: Vec<Mutex<Option<(usize, Instant)>>> = (0..threads).map(|_| Mutex::new(None)).collect();
+    std::thread::scope(|scope| {
+        let (done, wait) = mpsc::channel::<()>();
+        let (running, files) = (&running, &files);
+        scope.spawn(move || {
+            let mut reported = vec![usize::MAX; threads];
+            while let Err(RecvTimeoutError::Timeout) = wait.recv_timeout(Duration::from_millis(200)) {
+                for (worker, slot) in running.iter().enumerate() {
+                    if let Some((index, start)) = *slot.lock().unwrap() {
+                        if start.elapsed() >= slow && reported[worker] != index {
+                            reported[worker] = index;
+                            // libtest は print! の類だけを捕まえるので、止まったファイルの名前は端末か nextest の出力に出る
+                            let _ = writeln!(io::stderr(), "still running after {:?}: {}", slow, shown(&files[index]));
+                        }
+                    }
+                }
+            }
+        });
+        let workers: Vec<_> = running
+            .iter()
+            .map(|slot| {
+                scope.spawn(|| loop {
+                    let index = next.fetch_add(1, Ordering::Relaxed);
+                    let Some(path) = files.get(index) else { break };
+                    *slot.lock().unwrap() = Some((index, Instant::now()));
+                    let result = catch_unwind(AssertUnwindSafe(|| test(path)));
+                    *slot.lock().unwrap() = None;
+                    if let Err(payload) = result {
+                        let message = payload
+                            .downcast_ref::<String>()
+                            .map(String::as_str)
+                            .or_else(|| payload.downcast_ref::<&str>().copied())
+                            .unwrap_or("(no message)")
+                            .to_string();
+                        failures.lock().unwrap().push(format!("{}: {message}", shown(path)));
+                    }
+                })
+            })
+            .collect();
+        for worker in workers {
+            worker.join().unwrap();
+        }
+        drop(done);
+    });
+    let mut failures = failures.into_inner().unwrap();
+    failures.sort();
+    assert!(
+        failures.is_empty(),
+        "{} of {} files failed:\n{}",
+        failures.len(),
+        files.len(),
+        failures.join("\n")
+    );
 }
 
