@@ -0,0 +1,228 @@
+//! prototype: SIGPROF sampler walking the frame chain of the interrupted worker
+use std::collections::HashMap;
+use std::sync::atomic::{AtomicBool, AtomicUsize, Ordering::*};
+
+use crate::Symbol;
+
+pub static STMTS: AtomicUsize = AtomicUsize::new(0);
+pub static RANGES: AtomicUsize = AtomicUsize::new(0);
+pub static DEFAULT: AtomicUsize = AtomicUsize::new(0);
+pub static CODE: AtomicUsize = AtomicUsize::new(0);
+pub static FNS: AtomicUsize = AtomicUsize::new(0);
+pub static VARINT: AtomicUsize = AtomicUsize::new(0);
+pub static POINTS: AtomicUsize = AtomicUsize::new(0);
+pub static HASH: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+pub static CALLSEQ: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0);
+pub static CUR: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0);
+static JIT_LO: AtomicUsize = AtomicUsize::new(0);
+static JIT_HI: AtomicUsize = AtomicUsize::new(0);
+static LR_FIX: AtomicUsize = AtomicUsize::new(0);
+static LEAF_RT: AtomicUsize = AtomicUsize::new(0);
+static WALK_NS: AtomicUsize = AtomicUsize::new(0);
+static WALK_MAX_NS: AtomicUsize = AtomicUsize::new(0);
+static REC_MAX: AtomicUsize = AtomicUsize::new(0);
+static REC_SUM: AtomicUsize = AtomicUsize::new(0);
+static ROOTED: AtomicUsize = AtomicUsize::new(0);
+pub fn calls() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| std::env::var("EML_PF_NOCALLS").is_err())
+}
+fn now() -> usize {
+    unsafe {
+        let mut ts: libc::timespec = std::mem::zeroed();
+        libc::clock_gettime(libc::CLOCK_MONOTONIC, &mut ts);
+        ts.tv_sec as usize * 1_000_000_000 + ts.tv_nsec as usize
+    }
+}
+
+const DEPTH: usize = 64;
+const REC: usize = DEPTH + 2;
+const CAP: usize = 200_000;
+static mut BUF: [u64; CAP * REC] = [0; CAP * REC];
+static NEXT: AtomicUsize = AtomicUsize::new(0);
+static DROPPED: AtomicUsize = AtomicUsize::new(0);
+static FOREIGN: AtomicUsize = AtomicUsize::new(0);
+static STOP: AtomicBool = AtomicBool::new(false);
+static ENTER_LO: AtomicUsize = AtomicUsize::new(0);
+static HANDLER_NS: AtomicUsize = AtomicUsize::new(0);
+
+extern "C" fn handler(_sig: i32, _info: *mut libc::siginfo_t, uc: *mut libc::c_void) {
+    unsafe {
+        let me = libc::pthread_self();
+        if me as usize != eml_nrt::run::PROTO_THREAD.load(SeqCst) {
+            FOREIGN.fetch_add(1, Relaxed);
+            return;
+        }
+        let uc = uc as *mut libc::ucontext_t;
+        let ss = &(*(*uc).uc_mcontext).__ss;
+        let (pc, mut fp, sp) = (ss.__pc as usize, ss.__fp as usize, ss.__sp as usize);
+        let lr = ss.__lr as usize;
+        let (jlo, jhi) = (JIT_LO.load(Relaxed), JIT_HI.load(Relaxed));
+        let t0 = now();
+        let hi = libc::pthread_get_stackaddr_np(me) as usize;
+        let i = NEXT.fetch_add(1, Relaxed);
+        if i >= CAP {
+            DROPPED.fetch_add(1, Relaxed);
+            return;
+        }
+        let rec = (&raw mut BUF as *mut u64).add(i * REC);
+        *rec.add(2) = pc as u64;
+        let mut n = 1;
+        let mut flags = 0u64;
+        let lo = ENTER_LO.load(Relaxed);
+        let mut floor = sp;
+        let mut visited = 0usize;
+        let mut first = true;
+        loop {
+            if fp < floor || fp + 16 > hi || fp % 8 != 0 {
+                flags |= 2;
+                break;
+            }
+            let next = *(fp as *const usize);
+            visited += 1;
+            if n < DEPTH {
+                let ret = *((fp + 8) as *const usize);
+                if first {
+                    first = false;
+                    if !(pc >= jlo && pc < jhi) {
+                        LEAF_RT.fetch_add(1, Relaxed);
+                        if lr >= jlo && lr < jhi && lr != ret {
+                            LR_FIX.fetch_add(1, Relaxed);
+                        }
+                    }
+                }
+                *rec.add(2 + n) = ret as u64;
+                n += 1;
+                if ret >= lo && ret < lo + 256 {
+                    flags |= 1;
+                }
+            }
+            if next == 0 {
+                flags |= 4;
+                break;
+            }
+            if visited >= 8_000_000 { break; }
+            floor = fp + 16;
+            fp = next;
+        }
+        if flags & 4 != 0 { ROOTED.fetch_add(1, Relaxed); }
+        let dt = now() - t0;
+        WALK_NS.fetch_add(dt, Relaxed);
+        WALK_MAX_NS.fetch_max(dt, Relaxed);
+        REC_MAX.fetch_max(visited, Relaxed);
+        REC_SUM.fetch_add(visited, Relaxed);
+        *rec = n as u64;
+        *rec.add(1) = flags;
+    }
+}
+
+pub fn start(symbols: &[Symbol]) -> bool {
+    let Ok(hz) = std::env::var("EML_PF_HZ") else { return false };
+    let hz: u64 = hz.parse().unwrap_or(1000);
+    JIT_LO.store(symbols.iter().map(|s| s.address as usize).min().unwrap_or(0), Relaxed);
+    JIT_HI.store(symbols.iter().map(|s| s.address as usize + s.size as usize).max().unwrap_or(0), Relaxed);
+    if hz == 0 { return true; }
+    ENTER_LO.store(eml_nrt::eml_enter as usize, Relaxed);
+    unsafe {
+        let mut sa: libc::sigaction = std::mem::zeroed();
+        sa.sa_sigaction = handler as usize;
+        sa.sa_flags = libc::SA_SIGINFO | libc::SA_RESTART;
+        libc::sigaction(libc::SIGPROF, &sa, std::ptr::null_mut());
+    }
+    STOP.store(false, SeqCst);
+    std::thread::spawn(move || {
+        let period = std::time::Duration::from_nanos(1_000_000_000 / hz);
+        while !STOP.load(SeqCst) {
+            std::thread::sleep(period);
+            let t = eml_nrt::run::PROTO_THREAD.load(SeqCst);
+            if t != 0 {
+                unsafe { libc::pthread_kill(t as libc::pthread_t, libc::SIGPROF) };
+            }
+        }
+    });
+    true
+}
+
+fn name_of(symbols: &[(usize, usize, &str)], pc: usize, leaf: bool) -> String {
+    let look = if leaf { pc } else { pc.wrapping_sub(1) };
+    let i = symbols.partition_point(|s| s.0 <= look);
+    if i > 0 {
+        let s = symbols[i - 1];
+        if look < s.0 + s.1 {
+            return s.2.to_string();
+        }
+    }
+    unsafe {
+        let mut info: libc::Dl_info = std::mem::zeroed();
+        if libc::dladdr(look as *const libc::c_void, &mut info) != 0 && !info.dli_sname.is_null() {
+            let s = std::ffi::CStr::from_ptr(info.dli_sname).to_string_lossy();
+            let s = s.split("17h").next().unwrap_or("").to_string();
+            return format!("[rt]{}", s.chars().take(60).collect::<String>());
+        }
+    }
+    "[?]".to_string()
+}
+
+pub fn stop(symbols: &[Symbol], dt: std::time::Duration) {
+    STOP.store(true, SeqCst);
+    std::thread::sleep(std::time::Duration::from_millis(5));
+    let _ = HANDLER_NS.load(Relaxed);
+    let mut table: Vec<(usize, usize, &str)> = symbols
+        .iter()
+        .map(|s| (s.address as usize, s.size as usize, s.name.as_str()))
+        .collect();
+    table.sort();
+    let n = NEXT.load(SeqCst).min(CAP);
+    let (mut reached, mut broken, mut leaf_jit, mut maxd, mut full) = (0, 0, 0, 0, 0);
+    let mut folded: HashMap<String, usize> = HashMap::new();
+    let jit = |pc: usize| {
+        let i = table.partition_point(|s| s.0 <= pc);
+        i > 0 && pc < table[i - 1].0 + table[i - 1].1
+    };
+    for i in 0..n {
+        let rec = unsafe { std::slice::from_raw_parts((&raw const BUF as *const u64).add(i * REC), REC) };
+        let d = rec[0] as usize;
+        if rec[1] & 1 != 0 { reached += 1 }
+        if rec[1] & 2 != 0 { broken += 1 }
+        if d == DEPTH { full += 1 }
+        if jit(rec[2] as usize) { leaf_jit += 1 }
+        maxd = maxd.max(d);
+        let mut names: Vec<String> = (0..d).map(|k| name_of(&table, rec[2 + k] as usize, k == 0)).collect();
+        names.reverse();
+        // collapse runs of the same name (recursion) for a short key
+        let mut key = String::new();
+        let mut last = String::new();
+        for nm in names {
+            if nm != last {
+                if !key.is_empty() { key.push(';') }
+                key.push_str(&nm);
+                last = nm;
+            }
+        }
+        *folded.entry(key).or_default() += 1;
+    }
+    eprintln!(
+        "PF-PROTO samples={n} reached_enter={reached} broken={broken} depth_full={full} leaf_in_jit={leaf_jit} max_depth={maxd} foreign_thread={} dropped={} wall_ms={}",
+        FOREIGN.load(SeqCst), DROPPED.load(SeqCst), dt.as_millis()
+    );
+    eprintln!(
+        "PF-PROTO walk: rooted={} lr_fix={} leaf_outside_jit={} walk_ns_avg={} walk_ns_max={} records_avg={} records_max={}",
+        ROOTED.load(SeqCst), LR_FIX.load(SeqCst), LEAF_RT.load(SeqCst),
+        WALK_NS.load(SeqCst) / n.max(1), WALK_MAX_NS.load(SeqCst), REC_SUM.load(SeqCst) / n.max(1), REC_MAX.load(SeqCst)
+    );
+    eprintln!("PF-PROTO code: hash={:016x} varint_bytes={} points={}", HASH.load(SeqCst), VARINT.load(SeqCst), POINTS.load(SeqCst));
+    eprintln!(
+        "PF-PROTO srcloc: fns={} code_bytes={} lir_stmts={} ranges={} default_ranges={}",
+        FNS.load(SeqCst), CODE.load(SeqCst), STMTS.load(SeqCst), RANGES.load(SeqCst), DEFAULT.load(SeqCst)
+    );
+    let mut rows: Vec<_> = folded.into_iter().collect();
+    rows.sort_by(|a, b| b.1.cmp(&a.1));
+    for (k, c) in rows.iter().take(12) {
+        eprintln!("PF-PROTO {c} {k}");
+    }
+}
+
+pub fn src() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| std::env::var("EML_PF_NOSRC").is_err())
+}
