diff --git a/crates/eml_cli/src/interrupt/mod.rs b/crates/eml_cli/src/interrupt/mod.rs
new file mode 100644
index 00000000..5f472e84
--- /dev/null
+++ b/crates/eml_cli/src/interrupt/mod.rs
@@ -0,0 +1,114 @@
+//! Ctrl-C の受け口 (docs/spec/vm.md の「上限と割り込み」)。unix では SIGINT のハンドラ、Windows ではコンソールの
+//! handler が受け、どちらも static に置いた `Installed` の `respond` で何をするかを決める。
+
+use std::sync::{Arc, OnceLock};
+
+use eml_cli::Control;
+
+#[cfg(unix)]
+mod unix;
+#[cfg(unix)]
+use unix::register;
+#[cfg(windows)]
+mod windows;
+#[cfg(windows)]
+use windows::register;
+
+/// 受け口が読む `Control` と動き方。受け口の中ではロックを取れないので static に置く。`OnceLock::get` は初期化の後は
+/// アトミックな読みだけである。受け口は読んだ値を引数で受ける関数に渡すので、テストは static を使わない。
+static INSTALLED: OnceLock<Installed> = OnceLock::new();
+
+struct Installed {
+    control: Arc<Control>,
+    mode: Mode,
+}
+
+/// Ctrl-C を受けたときの動き方。
+#[derive(Clone, Copy)]
+pub enum Mode {
+    /// 2回目の Ctrl-C でその場で終わる。安全点に来ない処理から抜ける道である。
+    Run,
+    /// Ctrl-C で終わらない。抜けられない処理からは、unix では Ctrl-\、Windows では Ctrl-Break で抜ける
+    /// (docs/spec/repl.md の「残る制限」)。
+    Repl,
+}
+
+/// 2回目の Ctrl-C で終わるときの終了コード。1回目で止まったときと同じ値にする (docs/spec/vm.md の「上限と割り込み」)。
+const REPEAT_EXIT_CODE: u8 = 130;
+
+#[derive(Debug, PartialEq)]
+enum Response {
+    Interrupted,
+    /// まだ書いていない出力を捨てて、その場で終わる。
+    Exit,
+}
+
+/// `Control` と動き方を static に置いてから、受け口を入れる。逆の順だと、間に来た Ctrl-C が `Control` を見つけられ
+/// ない。
+pub fn install(control: Arc<Control>, mode: Mode) {
+    assert!(
+        INSTALLED.set(Installed { control, mode }).is_ok(),
+        "the Ctrl-C handler is installed once per process"
+    );
+    // 入れられなくてもプログラムは実行できる。その場合 Ctrl-C は既定の動作でプロセスを終わらせる
+    if let Err(error) = register() {
+        eprintln!("warning: cannot install the Ctrl-C handler: {error}");
+    }
+}
+
+impl Installed {
+    /// アトミックな読み書きだけをするので、シグナルのハンドラからも呼べる。
+    fn respond(&self) -> Response {
+        if matches!(self.mode, Mode::Run) && self.control.stop_bits() & Control::INTERRUPT != 0 {
+            return Response::Exit;
+        }
+        self.control.interrupt();
+        Response::Interrupted
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use eml_cli::Limits;
+
+    use super::*;
+
+    pub(super) fn installed(mode: Mode) -> Installed {
+        Installed {
+            control: Arc::new(Control::new(Limits::default())),
+            mode,
+        }
+    }
+
+    #[test]
+    fn the_first_ctrl_c_sets_the_interrupt_bit() {
+        for mode in [Mode::Run, Mode::Repl] {
+            let installed = installed(mode);
+            assert_eq!(installed.respond(), Response::Interrupted);
+            assert_eq!(installed.control.stop_bits(), Control::INTERRUPT);
+        }
+    }
+
+    #[test]
+    fn a_second_ctrl_c_ends_a_run() {
+        let installed = installed(Mode::Run);
+        installed.respond();
+        assert_eq!(installed.respond(), Response::Exit);
+    }
+
+    #[test]
+    fn a_second_ctrl_c_only_interrupts_the_repl() {
+        let installed = installed(Mode::Repl);
+        installed.respond();
+        assert_eq!(installed.respond(), Response::Interrupted);
+        assert_eq!(installed.control.stop_bits(), Control::INTERRUPT);
+    }
+
+    #[test]
+    fn a_ctrl_c_after_a_cleared_interrupt_is_a_first_one() {
+        let installed = installed(Mode::Run);
+        installed.respond();
+        installed.control.clear();
+        assert_eq!(installed.respond(), Response::Interrupted);
+    }
+}
diff --git a/crates/eml_cli/src/interrupt/unix.rs b/crates/eml_cli/src/interrupt/unix.rs
new file mode 100644
index 00000000..d398a40e
--- /dev/null
+++ b/crates/eml_cli/src/interrupt/unix.rs
@@ -0,0 +1,33 @@
+//! SIGINT のハンドラ。`SA_RESTART` を外すので、待っている読みは `EINTR` で戻り、`FileIn.read_all` が止める語を読んで
+//! 止まる (docs/spec/object-model.md の「読み手」)。
+
+use std::io;
+
+use super::{INSTALLED, REPEAT_EXIT_CODE, Response};
+
+pub(super) fn register() -> io::Result<()> {
+    // `SA_RESTART` を入れないので、ハンドラの後で待っている読みが `EINTR` で戻る。`SA_NODEFER` を入れないので、
+    // ハンドラが動く間は同じ SIGINT が塞がれ、`respond` が止める語を読んでから終わるかを決める間に入れ子にならない
+    let handler: extern "C" fn(libc::c_int) = on_sigint;
+    // `sigaction` は構造体と空の集合のほかに前提を持たない
+    let result = unsafe {
+        let mut action: libc::sigaction = std::mem::zeroed();
+        action.sa_sigaction = handler as libc::sighandler_t;
+        action.sa_flags = 0;
+        libc::sigemptyset(&mut action.sa_mask);
+        libc::sigaction(libc::SIGINT, &action, std::ptr::null_mut())
+    };
+    if result == 0 {
+        Ok(())
+    } else {
+        Err(io::Error::last_os_error())
+    }
+}
+
+/// async-signal-safe なことだけをする。アトミックな読み書きと `_exit` で、`errno` を変える関数は呼ばない。
+extern "C" fn on_sigint(_: libc::c_int) {
+    if let Some(Response::Exit) = INSTALLED.get().map(|installed| installed.respond()) {
+        // まだ書いていない出力は捨てる (docs/spec/vm.md の「上限と割り込み」)
+        unsafe { libc::_exit(REPEAT_EXIT_CODE.into()) }
+    }
+}
diff --git a/crates/eml_cli/src/interrupt/windows.rs b/crates/eml_cli/src/interrupt/windows.rs
new file mode 100644
index 00000000..2c07e744
--- /dev/null
+++ b/crates/eml_cli/src/interrupt/windows.rs
@@ -0,0 +1,101 @@
+//! コンソールの handler。std の標準入力はコンソールの読みが Ctrl-C で中断されても読み直し、pipe とファイルの読みは
+//! Ctrl-C で戻らないので、待っている読みは戻ってから止める語を見る (docs/spec/vm.md の「上限と割り込み」)。
+
+use std::io;
+
+use windows_sys::Win32::Foundation::{FALSE, TRUE};
+use windows_sys::Win32::System::Console::{CTRL_C_EVENT, SetConsoleCtrlHandler};
+use windows_sys::Win32::System::Threading::{GetCurrentProcess, TerminateProcess};
+use windows_sys::core::BOOL;
+
+use super::{INSTALLED, Installed, REPEAT_EXIT_CODE, Response};
+
+pub(super) fn register() -> io::Result<()> {
+    // 関数を足すだけで、ほかの前提を持たない
+    if unsafe { SetConsoleCtrlHandler(Some(on_console_event), TRUE) } != 0 {
+        Ok(())
+    } else {
+        Err(io::Error::last_os_error())
+    }
+}
+
+/// OS が作ったスレッドで動き、プログラムのスレッドと並んで走る。static を読み、終わり方を渡すことだけをする。
+unsafe extern "system" fn on_console_event(event: u32) -> BOOL {
+    console_event(INSTALLED.get(), event, terminate)
+}
+
+/// Ctrl-C のほかは FALSE を返して OS の既定の handler に任せる。Ctrl-Break は REPL から抜ける道で、閉じることと
+/// シャットダウンはプロセスを終わらせる (docs/spec/vm.md の「上限と割り込み」)。
+fn console_event(installed: Option<&Installed>, event: u32, exit: impl FnOnce(u32)) -> BOOL {
+    if event != CTRL_C_EVENT {
+        return FALSE;
+    }
+    let Some(installed) = installed else {
+        return FALSE;
+    };
+    if installed.respond() == Response::Exit {
+        exit(REPEAT_EXIT_CODE.into());
+    }
+    TRUE
+}
+
+/// `ExitProcess` はほかのスレッドを止めた後に DLL の後始末を呼び、止めたスレッドが持っていたロックで待ちうる。
+/// `_exit` と同じく、後始末をせずに終わらせる。まだ書いていない出力は捨てる。
+fn terminate(code: u32) {
+    // 自分のプロセスの擬似ハンドルを渡すだけで、ほかの前提を持たない
+    unsafe { TerminateProcess(GetCurrentProcess(), code) };
+}
+
+#[cfg(test)]
+mod tests {
+    use std::cell::Cell;
+
+    use eml_cli::Control;
+    use windows_sys::Win32::System::Console::{
+        CTRL_BREAK_EVENT, CTRL_CLOSE_EVENT, CTRL_LOGOFF_EVENT, CTRL_SHUTDOWN_EVENT,
+    };
+
+    use super::super::Mode;
+    use super::super::tests::installed;
+    use super::*;
+
+    #[test]
+    fn the_console_handler_takes_ctrl_c_and_ends_a_run_on_the_second() {
+        let installed = installed(Mode::Run);
+        let exited = Cell::new(None);
+        assert_eq!(
+            console_event(Some(&installed), CTRL_C_EVENT, |code| exited
+                .set(Some(code))),
+            TRUE
+        );
+        assert_eq!(installed.control.stop_bits(), Control::INTERRUPT);
+        assert_eq!(exited.get(), None);
+        assert_eq!(
+            console_event(Some(&installed), CTRL_C_EVENT, |code| exited
+                .set(Some(code))),
+            TRUE
+        );
+        assert_eq!(exited.get(), Some(130));
+    }
+
+    #[test]
+    fn the_console_handler_leaves_the_other_events_to_the_system() {
+        let installed = installed(Mode::Run);
+        for event in [
+            CTRL_BREAK_EVENT,
+            CTRL_CLOSE_EVENT,
+            CTRL_LOGOFF_EVENT,
+            CTRL_SHUTDOWN_EVENT,
+        ] {
+            assert_eq!(
+                console_event(Some(&installed), event, |_| panic!("exited")),
+                FALSE
+            );
+        }
+        assert_eq!(installed.control.stop_bits(), 0);
+        assert_eq!(
+            console_event(None, CTRL_C_EVENT, |_| panic!("exited")),
+            FALSE
+        );
+    }
+}
