+/// SNI と証明書の照合に使う名前
+#[derive(Clone, Debug)]
+pub struct Name(ServerName<'static>);
+impl Name {
+    pub fn parse(name: &str) -> Result<Name, Error> {
+        ServerName::try_from(name.to_owned()).map(Name).map_err(|_| Error::ServerName)
+    }
+}
+
+/// 証明書の確かめ方。作るのはブロックしうるので (Linux は根のファイルを読む)、接続を作る `Conn::client` と分ける
+#[derive(Clone, Debug)]
+pub struct Trust {
+    verifier: Arc<dyn ServerCertVerifier>,
+    now: Option<UnixTime>,
+}
+
+fn extra_roots(pem: &[u8]) -> Result<Vec<CertificateDer<'static>>, Error> {
+    let mut check = RootCertStore::empty();
+    let mut roots = Vec::new();
+    for der in CertificateDer::pem_slice_iter(pem) {
+        let der = der.map_err(|_| Error::CaPem)?;
+        check.add(der.clone()).map_err(|_| Error::CaPem)?;
+        roots.push(der);
+    }
+    if !pem.is_empty() && roots.is_empty() {
+        return Err(Error::CaPem);
+    }
+    Ok(roots)
+}
+
+impl Trust {
+    pub fn platform(extra_ca_pem: &[u8]) -> Result<Trust, Error> {
+        static DEFAULT: OnceLock<Trust> = OnceLock::new();
+        if extra_ca_pem.is_empty() {
+            if let Some(t) = DEFAULT.get() {
+                return Ok(t.clone());
+            }
+        }
+        let t = Trust::platform_inner(extra_ca_pem, None)?;
+        if extra_ca_pem.is_empty() {
+            let _ = DEFAULT.set(t.clone());
+        }
+        Ok(t)
+    }
+
+    pub fn platform_at(extra_ca_pem: &[u8], now: UnixTime) -> Result<Trust, Error> {
+        Trust::platform_inner(extra_ca_pem, Some(now))
+    }
+
+    fn platform_inner(extra_ca_pem: &[u8], now: Option<UnixTime>) -> Result<Trust, Error> {
+        let roots = extra_roots(extra_ca_pem)?;
+        let none = roots.is_empty();
+        let v = rustls_platform_verifier::Verifier::new_with_extra_roots(roots, provider())
+            .map_err(|e| match e {
+                _ if none => Error::NoRoots,
+                rustls::Error::InvalidCertificate(_) => Error::CaPem,
+                _ => Error::Config,
+            })?;
+        Ok(Trust { verifier: Arc::new(Opaque(Arc::new(v))), now })
+    }
+
+    pub fn fixtures(ca_pem: &[u8]) -> Result<Trust, Error> {
+        let mut store = RootCertStore::empty();
+        for der in extra_roots(ca_pem)? {
+            store.add(der).map_err(|_| Error::CaPem)?;
+        }
+        let v = WebPkiServerVerifier::builder_with_provider(Arc::new(store), provider())
+            .build()
+            .map_err(|_| Error::NoRoots)?;
+        Ok(Trust { verifier: Arc::new(Opaque(v)), now: Some(fixtures::NOW) })
+    }
+}
+
+#[derive(Debug)]
+struct Pinned(UnixTime);
