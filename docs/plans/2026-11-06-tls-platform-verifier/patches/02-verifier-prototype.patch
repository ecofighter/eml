@@ -0,0 +1,50 @@
+use eml_tls::fixtures::{CA_PEM, CERT_PEM, KEY_PEM, NOW, OTHER_CA_PEM};
+use eml_tls::{Conn, FAILED, Trust};
+
+fn pump(a: &mut Conn, b: &mut Conn) {
+    loop {
+        let mut ab = Vec::new();
+        a.pull_tls(&mut ab);
+        b.push_tls(&ab);
+        let mut ba = Vec::new();
+        b.pull_tls(&mut ba);
+        a.push_tls(&ba);
+        if ab.is_empty() && ba.is_empty() {
+            break;
+        }
+    }
+}
+
+fn handshake(name: &str, trust: &Trust) -> Conn {
+    let mut c = Conn::client(name, trust).unwrap();
+    let mut s = Conn::server(CERT_PEM, KEY_PEM).unwrap();
+    pump(&mut c, &mut s);
+    c
+}
+
+#[test]
+fn an_extra_root_is_trusted() {
+    for name in ["tls.localhost", "127.0.0.1"] {
+        let c = handshake(name, &Trust::platform_at(CA_PEM, NOW).unwrap());
+        assert_eq!(c.status(), 0, "{name}: {}", c.error_message());
+    }
+}
+
+#[test]
+fn an_unknown_ca_is_rejected() {
+    let c = handshake("tls.localhost", &Trust::platform_at(OTHER_CA_PEM, NOW).unwrap());
+    assert_eq!(c.status() & FAILED, FAILED);
+    assert_eq!(c.error_message(), "the server certificate was rejected");
+}
+
+#[test]
+fn a_name_not_in_the_certificate_is_rejected() {
+    let c = handshake("example.com", &Trust::platform_at(CA_PEM, NOW).unwrap());
+    assert_eq!(c.error_message(), "the server certificate was rejected");
+}
+
+#[test]
+fn the_fixtures_are_expired_at_the_real_time() {
+    let c = handshake("tls.localhost", &Trust::platform(CA_PEM).unwrap());
+    assert_eq!(c.error_message(), "the server certificate was rejected");
+}
